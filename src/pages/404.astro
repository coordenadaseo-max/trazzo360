---
import Layout from '../layouts/Layout.astro';
import { SITE } from '../data/site';

const title = 'Página no encontrada | ' + SITE.name;
const description = 'La página que buscas no existe o ha sido movida. Vuelve al inicio o consulta nuestros servicios de reforma.';
---

<Layout title={title} description={description} robots="noindex, follow">
  <section class="min-h-[60vh] flex items-center justify-center px-4 py-24">
    <div class="max-w-xl text-center">
      <p class="text-xs uppercase tracking-widest text-gray-400 mb-4">Error 404</p>
      <h1 class="text-3xl font-black text-gray-900 mb-4" style="letter-spacing:-0.02em">Página no encontrada</h1>
      <p class="text-gray-600 mb-8 leading-relaxed">
        La URL que has introducido no existe o ha cambiado. Puedes volver al inicio o consultar nuestros servicios.
      </p>
      <div class="flex flex-col sm:flex-row gap-3 justify-center">
        <a href="/" class="inline-block bg-[#111827] text-white font-semibold px-6 py-3 text-sm hover:opacity-90 transition-opacity">
          Ir al inicio
        </a>
        <a href="/contacto/" class="inline-block border border-gray-300 text-gray-700 font-semibold px-6 py-3 text-sm hover:border-[#A85535] hover:text-[#A85535] transition-colors">
          Contactar
        </a>
      </div>
    </div>
  </section>
</Layout>
