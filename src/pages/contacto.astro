---
import Layout from '../layouts/Layout.astro';
import Breadcrumb from '../components/ui/Breadcrumb.astro';
import { SITE, SERVICES, ZONES } from '../data/site';
---

<Layout
  title="Presupuesto Gratis · Corredor del Henares | Trazzo360"
  description={`Solicita tu presupuesto gratuito para reformas en Alcalá de Henares y el Corredor del Henares. Visita técnica gratuita. Precio cerrado garantizado.`}
>

  <Breadcrumb items={[{ label: 'Contacto' }]} />

  <!-- Hero -->
  <section class="bg-[#111827] py-16 lg:py-24" aria-labelledby="h-hero">
    <div class="max-w-7xl mx-auto px-4 text-center">
      <p class="text-xs font-bold uppercase tracking-widest text-[#A85535] mb-4">Presupuesto gratuito</p>
      <h1 id="h-hero" class="h1-page h1-page--dark mb-4">Cuéntanos tu reforma</h1>
      <p class="text-lg text-gray-300 max-w-xl mx-auto">Cuéntanos qué quieres reformar. Revisamos los detalles y concertamos la visita técnica gratuita.</p>
    </div>
  </section>

  <!-- Formulario + Datos -->
  <section class="py-20 bg-white" aria-labelledby="h-formulario">
    <div class="max-w-7xl mx-auto px-4 grid lg:grid-cols-3 gap-12">

      <!-- Formulario -->
      <div class="lg:col-span-2">
        <h2 id="h-formulario" class="h4-block mb-8 reveal">Solicitar presupuesto</h2>
        <!--
          PRE-LAUNCH BLOCKER: Configurar Formspree antes de publicar.
          1. Crea una cuenta gratuita en https://formspree.io
          2. Crea un nuevo formulario y copia tu ID (ej: xpzgkwqr)
          3. Reemplaza YOUR_FORM_ID en el action de abajo
          4. Opcional: crea /src/pages/gracias.astro para la página de confirmación
        -->
        <form class="space-y-5" action="https://formspree.io/f/YOUR_FORM_ID" method="POST">
          <input type="hidden" name="_subject" value="Nueva solicitud de presupuesto - Trazzo360" />
          <input type="hidden" name="_next" value="https://trazzo360.es/gracias/" />
          <div class="grid sm:grid-cols-2 gap-5">
            <div>
              <label for="f-nombre" class="block text-sm font-semibold text-gray-700 mb-2">Nombre *</label>
              <input id="f-nombre" type="text" name="nombre" required placeholder="Tu nombre"
                class="w-full px-4 py-3 border border-gray-200 bg-gray-50 text-gray-900 focus:outline-none focus:border-[#A85535] transition-colors text-sm" />
            </div>
            <div>
              <label for="f-telefono" class="block text-sm font-semibold text-gray-700 mb-2">Teléfono *</label>
              <input id="f-telefono" type="tel" name="telefono" required placeholder="612 345 678"
                class="w-full px-4 py-3 border border-gray-200 bg-gray-50 text-gray-900 focus:outline-none focus:border-[#A85535] transition-colors text-sm" />
            </div>
          </div>
          <div>
            <label for="f-email" class="block text-sm font-semibold text-gray-700 mb-2">Email</label>
            <input id="f-email" type="email" name="email" placeholder="tu@email.com"
              class="w-full px-4 py-3 border border-gray-200 bg-gray-50 text-gray-900 focus:outline-none focus:border-[#A85535] transition-colors text-sm" />
          </div>
          <div class="grid sm:grid-cols-2 gap-5">
            <div>
              <label for="f-servicio" class="block text-sm font-semibold text-gray-700 mb-2">Tipo de reforma *</label>
              <select id="f-servicio" name="servicio" required
                class="w-full px-4 py-3 border border-gray-200 bg-gray-50 text-gray-900 focus:outline-none focus:border-[#A85535] transition-colors text-sm">
                <option value="">Selecciona...</option>
                {SERVICES.map(s => <option value={s.slug}>{s.title}</option>)}
              </select>
            </div>
            <div>
              <label for="f-zona" class="block text-sm font-semibold text-gray-700 mb-2">Localidad</label>
              <select id="f-zona" name="zona"
                class="w-full px-4 py-3 border border-gray-200 bg-gray-50 text-gray-900 focus:outline-none focus:border-[#A85535] transition-colors text-sm">
                <option value="">Selecciona...</option>
                {ZONES.map(z => <option value={z.slug}>{z.name}</option>)}
                <option value="otra">Otra localidad</option>
              </select>
            </div>
          </div>
          <div>
            <label for="f-mensaje" class="block text-sm font-semibold text-gray-700 mb-2">Cuéntanos tu proyecto</label>
            <textarea id="f-mensaje" name="mensaje" rows={5} placeholder="Describe brevemente qué quieres reformar, superficie aproximada y cualquier detalle que consideres importante..."
              class="w-full px-4 py-3 border border-gray-200 bg-gray-50 text-gray-900 focus:outline-none focus:border-[#A85535] transition-colors text-sm resize-none"></textarea>
          </div>
          <div class="flex items-start gap-3">
            <input type="checkbox" id="privacidad" name="privacidad" required class="mt-1 accent-[#A85535]" />
            <label for="privacidad" class="text-xs text-gray-500">
              He leído y acepto la <a href="/privacidad/" class="underline hover:text-[#A85535]">política de privacidad</a>. Mis datos serán usados exclusivamente para gestionar esta solicitud.
            </label>
          </div>
          <button type="submit"
            class="w-full sm:w-auto px-10 py-4 font-bold text-sm uppercase tracking-widest text-white hover:opacity-90 transition-opacity"
            style="background:#A85535">
            Enviar solicitud de presupuesto
          </button>
        </form>
      </div>

      <!-- Sidebar contacto -->
      <div class="space-y-6">
        <div class="bg-[#F9F7F4] p-7">
          <p class="text-xs font-bold uppercase tracking-widest text-[#A85535] mb-4">Contacto directo</p>
          <div class="space-y-4">
            <div>
              <p class="text-xs text-gray-400 uppercase font-bold mb-1">Teléfono</p>
              <a href={`tel:${SITE.phone}`} class="text-lg font-black text-gray-900 hover:text-[#A85535] transition-colors">{SITE.phoneDisplay}</a>
            </div>
            <div>
              <p class="text-xs text-gray-400 uppercase font-bold mb-1">Email</p>
              <a href={`mailto:${SITE.email}`} class="text-sm text-gray-700 hover:text-[#A85535] transition-colors">{SITE.email}</a>
            </div>
            {SITE.phone !== 'TU_TELEFONO' && (
            <div>
              <p class="text-xs text-gray-400 uppercase font-bold mb-1">Horario</p>
              <p class="text-sm text-gray-700">{SITE.hours}</p>
            </div>
            )}
            <div>
              <p class="text-xs text-gray-400 uppercase font-bold mb-1">Zona de actuación</p>
              <p class="text-sm text-gray-700">{SITE.zone}</p>
            </div>
          </div>
          {/* PRE-LAUNCH BLOCKER: activar cuando SITE.whatsapp tenga número real */}
          {SITE.whatsapp !== 'TU_TELEFONO' && (
            <a href={`https://wa.me/${SITE.whatsapp}`} target="_blank" rel="noopener noreferrer"
              class="flex items-center justify-center gap-2 w-full mt-6 py-3 text-sm font-bold text-white transition-opacity hover:opacity-90"
              style="background:#25D366">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
              Escribir por WhatsApp
            </a>
          )}
        </div>

        {/* PRE-LAUNCH BLOCKER: bloque "Respondemos en Xh" — pendiente validación del titular */}
      </div>
    </div>
  </section>

  <!-- Qué pasa tras enviar -->
  <section class="py-16 bg-[#F9F7F4]" aria-labelledby="h-proceso">
    <div class="max-w-4xl mx-auto px-4">
      <h2 id="h-proceso" class="text-xl font-black text-gray-900 mb-2">Qué pasa después de enviar el formulario</h2>
      <p class="text-sm text-gray-500 mb-8">El proceso es siempre el mismo, independientemente del tipo de obra o del municipio.</p>
      <ol class="grid sm:grid-cols-3 gap-6" style="list-style:none;padding:0;margin:0">
        {[
          {
            n: '1',
            title: 'Revisamos tu solicitud y te contactamos',
            desc: 'Leemos los detalles de tu proyecto y te llamamos para resolver dudas iniciales y acordar la visita técnica.',
          },
          {
            n: '2',
            title: 'Visita técnica gratuita',
            desc: 'Acordamos una visita en tu vivienda o local. Tomamos medidas, evaluamos el estado de las instalaciones y respondemos todas las preguntas.',
          },
          {
            n: '3',
            title: 'Recibes el presupuesto por escrito',
            desc: 'El presupuesto incluye el precio total y el plazo de entrega cerrados. Sin partidas abiertas ni sorpresas después de firmar.',
          },
        ].map(step => (
          <li class="flex gap-4">
            <div class="w-8 h-8 bg-[#A85535] text-white text-sm font-black flex items-center justify-center flex-shrink-0 mt-0.5" aria-hidden="true">
              {step.n}
            </div>
            <div>
              <h3 class="text-sm font-bold text-gray-900 mb-1">{step.title}</h3>
              <p class="text-xs text-gray-500 leading-relaxed">{step.desc}</p>
            </div>
          </li>
        ))}
      </ol>
      <div class="mt-8 bg-white border-l-4 border-[#A85535] p-5">
        <p class="text-sm text-gray-600">
          <strong class="text-gray-900">¿Tienes urgencia?</strong> Llámanos directamente al <a href={`tel:${SITE.phone}`} class="text-[#A85535] font-bold hover:underline">{SITE.phoneDisplay}</a> o escríbenos por WhatsApp.
        </p>
      </div>
    </div>
  </section>

  <!-- Zonas del Corredor -->
  <section class="py-16 bg-white" aria-labelledby="h-zonas">
    <div class="max-w-7xl mx-auto px-4">
      <h2 id="h-zonas" class="text-xl font-black text-gray-900 mb-2">Cubrimos todo el Corredor del Henares</h2>
      <p class="text-sm text-gray-500 mb-8 max-w-2xl">
        Trabajamos en {ZONES.length} municipios sin coste adicional por desplazamiento. Visita técnica y presupuesto gratuitos en toda la zona.
      </p>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
        {ZONES.map(z => (
          <a href={`/zonas/${z.slug}/`}
            class="block p-4 bg-gray-50 border border-gray-100 hover:border-[#A85535] transition-colors group">
            <p class="font-semibold text-gray-800 group-hover:text-[#A85535] transition-colors text-sm">{z.name}</p>
            <p class="text-xs text-gray-400 mt-1 group-hover:text-[#A85535]/70 transition-colors">Ver servicios y precios →</p>
          </a>
        ))}
      </div>
    </div>
  </section>

</Layout>
