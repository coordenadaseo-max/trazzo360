      <h2 id="h-zonas" class="text-2xl font-black text-gray-900 mb-3" style="letter-spacing:-0.02em">
        Reforma de pisos y viviendas en el Corredor: todos los municipios
      </h2>
      <p class="text-gray-600 leading-relaxed mb-8 max-w-2xl">
        Hacemos reformas de viviendas en los ocho municipios del Corredor del Henares sin coste adicional de desplazamiento. Selecciona tu municipio para ver información sobre el mercado y los plazos habituales en tu zona.
      </p>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
        {zones.map(z => (
          <article class="group relative p-5 bg-[#F9F7F4] hover:bg-[#111827] transition-colors duration-200">
            <h3 class="text-sm font-bold text-gray-900 group-hover:text-white transition-colors duration-200 m-0">
              <a href={`/reforma-pisos/${z.slug}/`} class="after:absolute after:inset-0 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#A85535]">
                Reforma de pisos en {z.name}
              </a>
            </h3>
            <span aria-hidden="true" class="text-xs text-gray-400 mt-1 group-hover:text-gray-300 transition-colors duration-200 block">Ver precios y plazos →</span>
          </article>
        ))}
      </div>
      <div class="mt-10 pt-8 border-t border-gray-100">
        <p class="text-sm text-gray-500 mb-4">Si tu reforma necesita un alcance diferente:</p>
        <div class="flex flex-wrap gap-3">
          <a href="/servicios/reformas-integrales/" class="inline-block px-4 py-2 text-sm font-medium text-gray-700 bg-gray-100 hover:bg-[#A85535] hover:text-white transition-colors">Reformas integrales (instalaciones incluidas)</a>
          <a href="/servicios/reforma-banos/" class="inline-block px-4 py-2 text-sm font-medium text-gray-700 bg-gray-100 hover:bg-[#A85535] hover:text-white transition-colors">Reforma de baños</a>
          <a href="/servicios/reforma-cocinas/" class="inline-block px-4 py-2 text-sm font-medium text-gray-700 bg-gray-100 hover:bg-[#A85535] hover:text-white transition-colors">Reforma de cocinas</a>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-20 bg-[#F9F7F4]" aria-labelledby="h-faq">
    <div class="max-w-4xl mx-auto px-4">
      <div class="mb-10">
        <p class="text-xs font-bold uppercase tracking-widest text-[#A85535] mb-3">Preguntas frecuentes</p>
        <h2 id="h-faq" class="text-3xl lg:text-4xl font-black text-gray-900 mb-3" style="letter-spacing:-0.02em;text-wrap:balance">
          Todo lo que necesitas saber sobre reforma de vivienda
        </h2>
      </div>
      <div class="divide-y divide-gray-200">
        {faqs.map(faq => (
          <details class="group py-5">
            <summary class="flex justify-between items-start gap-4 cursor-pointer list-none">
              <h3 class="font-semibold text-gray-900 text-base leading-snug m-0">{faq.q}</h3>
              <span class="text-gray-400 text-xl leading-none select-none font-normal block group-open:hidden" aria-hidden="true">+</span>
              <span class="text-gray-400 text-xl leading-none select-none font-normal hidden group-open:block" aria-hidden="true">−</span>
            </summary>
            <p class="mt-4 text-gray-500 leading-relaxed text-sm">{faq.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA Final -->
  <section class="py-20 bg-[#111827]" aria-labelledby="h-cta-final">
    <div class="max-w-4xl mx-auto px-4 text-center">
      <h2 id="h-cta-final" class="text-3xl lg:text-4xl font-black text-white mb-3" style="letter-spacing:-0.02em">
        ¿Cuánto cuesta reformar tu vivienda?
      </h2>
      <p class="text-gray-400 mb-2">Visita técnica gratuita. Presupuesto cerrado por escrito.</p>
      <p class="text-gray-600 text-sm mb-10">Sin compromiso. El precio que firmamos es el precio que pagas.</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/contacto/" class="inline-block px-10 py-4 font-bold text-sm uppercase tracking-widest bg-[#A85535] text-white hover:bg-[#8A4229] transition-colors">Solicitar presupuesto</a>
        <a href={`tel:${SITE.phone}`} class="inline-block px-10 py-4 font-bold text-sm uppercase tracking-widest text-white border border-white/30 hover:border-white transition-colors">{SITE.phoneDisplay}</a>
      </div>
    </div>
  </section>

</Layout>

<style>
  .hero-c-grid { display:grid; gap:1.5rem; }
  @media(min-width:1024px){ .hero-c-grid { grid-template-columns:55fr 22fr 23fr; gap:3rem; } }
  .compromisos-apertura-grid { display:grid; gap:2rem; }
  @media(min-width:768px){ .compromisos-apertura-grid { grid-template-columns:auto 1fr; gap:4rem; align-items:start; } }
</style>
