---
import '../../styles/global.css';
---
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex, nofollow, noarchive" />
  <title>LAB · Hero A · Fotografía</title>
  <style>html{scroll-behavior:smooth}*{box-sizing:border-box}</style>
</head>
<body class="font-sans antialiased m-0 p-0">

  <div class="fixed top-0 left-0 right-0 z-50 bg-yellow-400 text-yellow-950 px-4 py-1.5 flex items-center justify-between">
    <span class="text-[10px] font-black uppercase tracking-[0.15em]">LAB · HERO A · Composición 60/40 con fotografía</span>
    <nav class="hidden md:flex gap-4 text-[10px] font-bold uppercase tracking-widest">
      <a href="/lab/hero-a" class="underline">A</a>
      <a href="/lab/hero-c">C</a>
      <a href="/lab/tiempo">Tiempo</a>
      <a href="/lab/precio">Precio</a>
      <a href="/lab/garantia">Garantía</a>
    </nav>
  </div>

  <section class="bg-[#111827] relative overflow-hidden" style="min-height:100vh;padding-top:30px">

    <!-- Foto: 42% derecho, full height, absolute -->
    <div class="hidden lg:block absolute right-0 top-[30px] bottom-0 bg-[#1D2A3E]" style="width:42%">
      <!-- Grilla sutil placeholder -->
      <div class="absolute inset-0 opacity-[0.035]"
           style="background-image:repeating-linear-gradient(0deg,#fff 0,#fff 1px,transparent 1px,transparent 56px),repeating-linear-gradient(90deg,#fff 0,#fff 1px,transparent 1px,transparent 56px)"></div>
      <!-- Label placeholder centrado -->
      <div class="absolute inset-0 flex items-center justify-center pointer-events-none select-none">
        <div class="text-center">
          <svg class="mx-auto mb-3 opacity-30" width="36" height="36" fill="none" stroke="#9CA3AF" viewBox="0 0 24 24">
            <rect x="3" y="3" width="18" height="18" rx="1" stroke-width="1.2"/>
            <circle cx="8.5" cy="8.5" r="1.5" stroke-width="1.2"/>
            <path d="m21 15-5-5L5 21" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          <p style="font-size:9px;font-weight:700;letter-spacing:.15em;text-transform:uppercase;color:#4B5563">PROTOTIPO</p>
          <p style="font-size:9px;letter-spacing:.1em;text-transform:uppercase;color:#374151;margin-top:4px">Fotografía real · Baño terminado</p>
          <p style="font-size:9px;color:#374151;margin-top:2px">Formato vertical 3:4 · A sangre</p>
        </div>
      </div>
      <!-- Dato superpuesto — esquina inferior izquierda de la foto -->
      <div class="absolute bottom-10 left-8">
        <div class="px-6 py-5" style="background:rgba(17,24,39,0.93)">
          <p style="font-size:9px;font-weight:700;letter-spacing:.15em;text-transform:uppercase;color:#6B7280;margin-bottom:4px">Precio orientativo desde</p>
          <p class="text-white font-black leading-none" style="font-size:clamp(2rem,3.5vw,2.5rem);letter-spacing:-0.035em">3.200€</p>
          <p style="font-size:10px;color:#4B5563;margin-top:6px">reforma completa · baño hasta 5 m²</p>
        </div>
      </div>
    </div>

    <!-- Texto: columna izquierda -->
    <div class="max-w-7xl mx-auto px-4 lg:px-8">
      <div class="flex flex-col justify-center" style="min-height:calc(100vh - 30px);padding:5rem 0;padding-right:0">
        <div style="max-width:min(56vw, 680px)">

          <p style="font-size:9px;font-weight:900;letter-spacing:.15em;text-transform:uppercase;color:#A85535;margin-bottom:1.75rem">
            Reforma de baños · Corredor del Henares
          </p>

          <h1 class="text-white font-black"
              style="font-size:clamp(2.75rem,5.5vw,5.5rem);letter-spacing:-0.033em;line-height:0.92;text-wrap:balance;margin-bottom:2rem">
            Reforma de baños en el Corredor del Henares
          </h1>

          <p class="leading-relaxed" style="color:#D1D5DB;font-size:clamp(0.9rem,1.1vw,1.05rem);max-width:52ch;margin-bottom:2.5rem">
            Reformamos baños con precio cerrado por contrato: cambio de bañera por ducha, alicatado completo, fontanería y sanitarios. El presupuesto, cerrado tras la visita técnica gratuita, no varía una vez firmado.
          </p>

          <div class="flex flex-col sm:flex-row gap-4 mb-8">
            <a href="/contacto/" class="inline-block text-center text-white font-black text-xs uppercase"
               style="padding:1rem 2rem;background:#A85535;letter-spacing:.1em">
              Solicitar presupuesto gratis
            </a>
            <a href="tel:000" class="inline-block text-center text-white font-black text-xs uppercase"
               style="padding:1rem 2rem;border:1px solid rgba(255,255,255,.25);letter-spacing:.1em">
              900 000 000
            </a>
          </div>

          <!-- Stats inline — solo mobile -->
          <div class="flex gap-8 pt-6 lg:hidden" style="border-top:1px solid rgba(255,255,255,.1)">
            <div>
              <p class="text-white font-black leading-none" style="font-size:1.5rem;letter-spacing:-0.03em">3.200€</p>
              <p style="font-size:10px;color:#6B7280;margin-top:4px">reforma completa</p>
            </div>
            <div>
              <p class="text-white font-black leading-none" style="font-size:1.5rem;letter-spacing:-0.03em">10–15</p>
              <p style="font-size:10px;color:#6B7280;margin-top:4px">días laborables</p>
            </div>
          </div>

        </div>
      </div>
    </div>
  </section>

</body>
</html>
