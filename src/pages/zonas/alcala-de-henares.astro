---
import Layout from '../../layouts/Layout.astro';
import Compromisos from '../../components/Compromisos.astro';
import { SITE, ZONES, ZONE_FAQS, RELATED_ZONES } from '../../data/site';

const zone = ZONES.find(z => z.slug === 'alcala-de-henares')!;
const faqs  = ZONE_FAQS['alcala-de-henares'] ?? [];
const relatedZoneSlugs = RELATED_ZONES['alcala-de-henares'] ?? [];
const relatedZones = ZONES.filter(z => relatedZoneSlugs.includes(z.slug));

// Índice tipológico — derivado de m2BarrioNotes, sin claims de volumen
const typoIndex = [
  {
    barrios:  'El Val · Barrio del Pilar',
    epoca:    'Bloques años 70–80',
    note:     'Mayor concentración de bloques de esta época en Alcalá. El cuadro eléctrico lleva en muchos casos décadas sin actualizar y suele ser la primera partida que aparece en la evaluación técnica.',
  },
  {
    barrios:  'Casco Histórico · Reyes Católicos',
    epoca:    'Vivienda histórica y promotoras 80–90',
    note:     'El alcance varía mucho según el estado real de cada inmueble. En Reyes Católicos, la demanda se centra en baño y cocina con menor necesidad de intervenir en instalaciones.',
  },
  {
    barrios:  'La Garena · Espartales',
    epoca:    'Crecimiento más reciente',
    note:     'Vivienda más reciente. La reforma se centra en acabados: suelos resistentes, baño actualizado y cocina funcional. El plazo es relevante cuando hay arrendamiento pendiente.',
  },
];

// Matriz tipológica — fuente: zones.ts · m2BarrioNotes
const matrizData = [
  {
    label:      'Zona A · instalaciones a evaluar primero',
    barrios:    'El Val · Barrio del Pilar',
    epoca:      'Bloques años 70–80',
    note:       'Mayor concentración de bloques de esta época en Alcalá. En muchos casos el cuadro eléctrico lleva décadas sin actualizar y suele ser la primera partida que aparece en la evaluación técnica antes de cerrar el presupuesto.',
    implication:'La evaluación de instalaciones precede a la elección de acabados. Si requieren renovación, abordar todo en la misma obra es más eficiente que intervenir en dos momentos distintos.',
  },
  {
    label:      'Zona B · variabilidad alta por inmueble',
    barrios:    'Casco Histórico · Reyes Católicos',
    epoca:      'Vivienda histórica y promotoras 80–90',
    note:       'El Casco combina vivienda antigua rehabilitada con pisos sin tocar en décadas. En Reyes Católicos predominan promociones de los 80-90 con instalaciones en general en mejor estado.',
    implication:'El alcance varía mucho según el estado real de cada inmueble. En Reyes Católicos, la demanda se centra en baño y cocina con menor necesidad de intervenir en instalaciones.',
  },
  {
    label:      'Zona C · crecimiento más reciente',
    barrios:    'La Garena · Espartales',
    epoca:      'Promociones más recientes',
    note:       'Vivienda más reciente con instalaciones en mejor estado. Hay propietarios que compran para reformar y alquilar, para los que el plazo es relevante cuando hay un contrato de arrendamiento pendiente.',
    implication:'La reforma se centra en acabados: suelos de porcelánico resistente, baño renovado y cocina funcional. Sin intervención habitual en instalaciones salvo revisión preventiva.',
  },
];

// Servicios editorial — 5 casos de necesidad · fuente: zones.ts · topWorks
const servicios = [
  {
    caso:   'Si la vivienda tiene instalaciones de los años 70–80',
    nombre: 'Reforma integral con instalaciones',
    desc:   'Cuando el cuadro eléctrico o la fontanería necesitan renovación, abordar todo en la misma obra es más eficiente. Se abre el piso una sola vez, los gremios se coordinan en un único periodo y el plazo total no se multiplica por el número de intervenciones. La actuación más habitual en El Val y Barrio del Pilar.',
    links:  [{ href: '/reformas-integrales/alcala-de-henares/', label: 'Reforma integral en Alcalá de Henares' }],
  },
  {
    caso:   'Si el baño necesita renovación completa',
    nombre: 'Reforma de baño',
    desc:   'Cambio de bañera por ducha de obra, alicatado hasta el techo, sanitarios y mueble. En bloques de los años 70-80 conviene evaluar la fontanería de la vivienda en la misma visita técnica, para no tener que reabrir el alicatado una vez terminado el baño.',
    links:  [{ href: '/reforma-banos/alcala-de-henares/', label: 'Reforma de baño en Alcalá de Henares' }],
  },
  {
    caso:   'Si la cocina está desfasada en acabados o distribución',
    nombre: 'Reforma de cocina',
    desc:   'Muebles, encimera y alicatado con electrodomésticos integrados. En Alcalá es frecuente combinar la reforma de cocina con la renovación del suelo de toda la vivienda en la misma obra, para aprovechar la movilización y evitar cortes de suministro en dos momentos distintos.',
    links:  [{ href: '/reforma-cocinas/alcala-de-henares/', label: 'Reforma de cocina en Alcalá de Henares' }],
  },
  {
    caso:   'Si las instalaciones están bien y el objetivo son los acabados',
    nombre: 'Reforma de piso',
    desc:   'Suelos, baño, cocina y pintura sin intervenir en instalaciones. Permite renovar completamente el aspecto de la vivienda en un plazo acotado. La combinación habitual cuando el objetivo es preparar la vivienda para uso o arrendamiento en zonas con vivienda más reciente.',
    links:  [{ href: '/reforma-pisos/alcala-de-henares/', label: 'Reforma de piso en Alcalá de Henares' }],
  },
  {
    caso:   'También en Alcalá de Henares',
    nombre: 'Locales comerciales y comunidades de vecinos',
    desc:   'Acondicionamiento de locales con gestión de licencia de actividad incluida, y obras en zonas comunes de comunidades de propietarios. Mismo proceso: visita técnica, presupuesto cerrado y plazo garantizado por contrato.',
    links:  [
      { href: '/locales-comerciales/alcala-de-henares/', label: 'Reforma de locales en Alcalá de Henares' },
      { href: '/comunidades-vecinos/alcala-de-henares/',  label: 'Comunidades de vecinos en Alcalá' },
    ],
  },
];

// Schemas
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio',    item: `${SITE.url}/` },
    { '@type': 'ListItem', position: 2, name: zone.name,   item: `${SITE.url}/zonas/${zone.slug}/` },
  ],
};
const zoneSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: `Obras y reformas en ${zone.name}`,
  url: `${SITE.url}/zonas/${zone.slug}/`,
  description: `Trazzo360, empresa de reformas en ${zone.name}. Reformas integrales, baños, cocinas, pisos y locales. Precio cerrado y presupuesto gratis en 24h.`,
  provider: { '@type': 'GeneralContractor', '@id': `${SITE.url}/#business` },
  areaServed: { '@type': 'City', name: zone.name },
};
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(f => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<Layout
  title={`Empresa de Reformas en ${zone.name} | ${SITE.name}`}
  description={`Trazzo360, empresa de reformas en ${zone.name}. Reformas integrales, baños, cocinas, pisos y locales con precio cerrado y visita técnica gratuita.`}
  schema={[zoneSchema, breadcrumbSchema, faqSchema]}
>

  <!-- Breadcrumb -->
  <nav aria-label="Migas de pan" class="bg-gray-50 border-b border-gray-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 py-3">
      <ol class="text-sm text-gray-500 flex items-center gap-2" style="list-style:none;padding:0;margin:0">
        <li><a href="/" class="hover:text-[#A85535] transition-colors">Inicio</a></li>
        <li aria-hidden="true" class="text-gray-300">/</li>
        <li>Zonas</li>
        <li aria-hidden="true" class="text-gray-300">/</li>
        <li class="text-gray-800 font-medium" aria-current="page">{zone.name}</li>
      </ol>
    </div>
  </nav>

  <!-- ── Hero A: dos columnas ── -->
  <section class="bg-[#111827] py-20 lg:py-28" aria-labelledby="h-hero">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      <div class="hero-a-grid">

        <!-- Columna izquierda: H1 + tesis + CTAs -->
        <div>
          <h1 id="h-hero" class="font-black text-white" style="letter-spacing:-0.035em;font-size:clamp(2.25rem,5.5vw,4.5rem);line-height:.95">
            <span class="block font-bold leading-snug mb-5" style="font-size:clamp(.75rem,1.35vw,.9375rem);letter-spacing:.02em;color:rgba(255,255,255,.38)">
              Empresa de reformas en {zone.name}
            </span>
            El barrio y el año<br>del edificio determinan<br>el alcance de la reforma.
          </h1>

          <p class="leading-relaxed mt-7 max-w-prose" style="font-size:1rem;color:rgba(255,255,255,.6)">
            El parque residencial de Alcalá no es homogéneo. Los bloques de los años 70 y 80 en El Val y Barrio del Pilar tienen instalaciones que condicionan el alcance antes de elegir materiales. Las zonas de crecimiento más reciente permiten centrarse directamente en los acabados.
          </p>

          <div class="flex flex-col sm:flex-row gap-3 mt-10">
            <a href="/contacto/" class="inline-block text-center px-7 py-3.5 font-black text-xs uppercase tracking-widest text-white hover:opacity-90 transition-opacity" style="background:#A85535">
              Solicitar visita técnica gratuita
            </a>
            <a href={`tel:${SITE.phone}`} class="inline-block text-center px-7 py-3.5 font-black text-xs uppercase tracking-widest text-white border border-white/20 hover:border-white/50 transition-colors">
              {SITE.phoneDisplay}
            </a>
          </div>

          <div class="flex flex-wrap gap-7 mt-7 pt-7" style="border-top:1px solid rgba(255,255,255,.08)">
            <span class="font-black text-xs uppercase tracking-widest" style="color:rgba(255,255,255,.3)">
              <strong style="color:rgba(255,255,255,.65)">Precio cerrado</strong> por contrato
            </span>
            <span class="font-black text-xs uppercase tracking-widest" style="color:rgba(255,255,255,.3)">
              <strong style="color:rgba(255,255,255,.65)">Plazo</strong> garantizado
            </span>
            <span class="font-black text-xs uppercase tracking-widest" style="color:rgba(255,255,255,.3)">
              <strong style="color:rgba(255,255,255,.65)">2 años</strong> de garantía
            </span>
          </div>
        </div>

        <!-- Columna derecha: índice tipológico editorial -->
        <nav aria-label="Perfiles de barrio en Alcalá de Henares" style="border-top:1px solid rgba(255,255,255,.08)">
          {typoIndex.map(item => (
            <div class="py-5" style="border-bottom:1px solid rgba(255,255,255,.08)">
              <p class="font-bold text-white mb-1" style="font-size:.9375rem">{item.barrios}</p>
              <p class="font-bold uppercase mb-2" style="font-size:.625rem;letter-spacing:.07em;color:#A85535">{item.epoca}</p>
              <p style="font-size:.8125rem;color:rgba(255,255,255,.45);line-height:1.6">{item.note}</p>
            </div>
          ))}
        </nav>

      </div>
    </div>
  </section>

  <!-- ── Matriz tipológica: el parque residencial ── -->
  <section class="py-20 bg-[#F9F7F4]" aria-labelledby="h-parque">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      <p class="font-black text-xs uppercase tracking-widest text-[#A85535] mb-4">El parque residencial</p>
      <h2 id="h-parque" class="text-2xl lg:text-3xl font-black text-gray-900 mb-3" style="letter-spacing:-0.02em">
        Alcalá de Henares — tres perfiles de barrio
      </h2>
      <p class="text-gray-500 leading-relaxed mb-10 max-w-2xl" style="font-size:.9375rem">
        La época de construcción y el estado de las instalaciones condicionan el alcance de cada reforma. Esta caracterización refleja lo que encontramos con más frecuencia en cada zona del parque residencial.
      </p>

      <div class="matriz-grid mb-8">
        {matrizData.map(cell => (
          <div class="bg-[#111827] p-7">
            <p class="mb-3" style="font-size:.5rem;font-weight:900;letter-spacing:.15em;text-transform:uppercase;color:rgba(255,255,255,.22)">{cell.label}</p>
            <p class="font-bold text-white mb-1" style="font-size:1.0625rem;line-height:1.25">{cell.barrios}</p>
            <p class="font-bold uppercase mb-4" style="font-size:.625rem;letter-spacing:.07em;color:#A85535">{cell.epoca}</p>
            <p class="mb-5" style="font-size:.8125rem;color:rgba(255,255,255,.48);line-height:1.65">{cell.note}</p>
            <div style="padding-top:1.25rem;border-top:1px solid rgba(255,255,255,.07)">
              <p class="mb-2" style="font-size:.4375rem;font-weight:900;letter-spacing:.15em;text-transform:uppercase;color:rgba(255,255,255,.2)">Implicación para el alcance</p>
              <p class="font-semibold" style="font-size:.875rem;color:rgba(255,255,255,.75);line-height:1.5">{cell.implication}</p>
            </div>
          </div>
        ))}
      </div>

      <!-- Permisos y tramitación -->
      <div class="bg-[#111827] p-6 text-white">
        <p class="font-bold text-xs uppercase tracking-widest text-[#A85535] mb-3">Permisos y tramitación</p>
        <p class="text-sm text-gray-300 leading-relaxed">{zone.m3Permits}</p>
      </div>
    </div>
  </section>

  <!-- ── Servicios editorial ── -->
  <section class="py-20 bg-white" aria-labelledby="h-servicios">
    <div class="max-w-5xl mx-auto px-4 sm:px-6">
      <p class="font-black text-xs uppercase tracking-widest text-[#A85535] mb-4">Reformas en {zone.name}</p>
      <h2 id="h-servicios" class="text-2xl lg:text-3xl font-black text-gray-900 mb-3" style="letter-spacing:-0.02em">
        Cubrimos todas las obras con precio cerrado
      </h2>
      <p class="text-gray-500 leading-relaxed mb-12 max-w-2xl" style="font-size:.9375rem">
        La visita técnica gratuita define el alcance según el estado real de la vivienda o local. Precio cerrado por contrato antes de empezar, plazo garantizado por escrito.
      </p>

      <div>
        {servicios.map(srv => (
          <div class="srv-item">
            <div>
              <p class="srv-caso">{srv.caso}</p>
            </div>
            <div>
              <p class="font-bold text-gray-900 mb-2" style="font-size:1.125rem;letter-spacing:-.01em">{srv.nombre}</p>
              <p class="text-gray-500 leading-relaxed mb-4" style="font-size:.9375rem">{srv.desc}</p>
              <div class="flex flex-wrap gap-5">
                {srv.links.map(l => (
                  <a href={l.href} class="srv-link">{l.label} →</a>
                ))}
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Compromisos + CTA interior ── -->
  <section class="py-16 bg-[#F9F7F4]" aria-labelledby="h-compromisos">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 grid lg:grid-cols-2 gap-12 items-center">
      <div>
        <h2 id="h-compromisos" class="text-2xl font-black text-gray-900 mb-6" style="letter-spacing:-0.02em">
          Lo que asumimos antes de empezar en {zone.name}
        </h2>
        <Compromisos variant="condensed" />
        <p class="text-xs text-gray-400 mt-5">
          <a href="/como-trabajamos/" class="text-[#A85535] hover:underline font-medium">Ver todos nuestros compromisos →</a>
        </p>
      </div>
      <div class="bg-[#111827] p-8 text-white">
        <p class="font-bold text-xs uppercase tracking-widest text-[#A85535] mb-4">Presupuesto gratuito</p>
        <p class="text-xl font-black text-white mb-2">Respondemos en 24h. Presupuesto cerrado tras la visita.</p>
        <p class="text-sm text-gray-400 mb-6 leading-relaxed">
          Sin compromiso. Cuéntanos qué quieres reformar en {zone.name}, concertamos visita técnica y entregamos presupuesto cerrado en 48h.
        </p>
        <a href="/contacto/" class="block text-center py-3.5 font-bold text-sm uppercase tracking-widest text-white hover:opacity-90 transition-opacity mb-3" style="background:#A85535">
          Solicitar presupuesto en {zone.name}
        </a>
        <a href={`tel:${SITE.phone}`} class="block text-center py-3 text-sm text-gray-300 border border-white/20 hover:border-white/50 transition-colors">
          {SITE.phoneDisplay}
        </a>
      </div>
    </div>
  </section>

  <!-- ── Barrios chips ── -->
  <section class="py-14 bg-white" aria-labelledby="h-barrios">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      <h2 id="h-barrios" class="text-xl font-black text-gray-900 mb-2" style="letter-spacing:-0.01em">
        Barrios y zonas de {zone.name} donde actuamos
      </h2>
      <p class="text-sm text-gray-500 mb-6">
        Cubrimos todos los barrios y urbanizaciones de {zone.name} sin coste adicional por desplazamiento.
      </p>
      <ul class="flex flex-wrap gap-2" style="list-style:none;padding:0;margin:0">
        {zone.neighborhoods.map((n: string) => (
          <li class="inline-block px-4 py-2 bg-gray-50 border border-gray-200 text-sm text-gray-700 font-medium">
            {n}
          </li>
        ))}
        <li class="inline-block px-4 py-2 bg-gray-50 border border-dashed border-gray-300 text-sm text-gray-400">
          ¿Tu barrio no aparece? Consúltanos
        </li>
      </ul>
    </div>
  </section>

  <!-- ── Otras zonas: navegación secundaria compacta ── -->
  <nav aria-label="Otras zonas del Corredor" class="py-8 bg-[#F9F7F4] border-t border-gray-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 flex flex-wrap items-center gap-x-6 gap-y-2">
      <span class="text-xs font-bold uppercase tracking-widest text-gray-400 flex-shrink-0">Otras zonas</span>
      {relatedZones.map(z => (
        <a
          href={`/zonas/${z.slug}/`}
          class="text-sm text-gray-500 hover:text-[#A85535] transition-colors"
        >
          {z.name}
        </a>
      ))}
    </div>
  </nav>

  <!-- ── FAQ ── -->
  <section class="py-20 bg-white" aria-labelledby="h-faq">
    <div class="max-w-4xl mx-auto px-4 sm:px-6">
      <h2 id="h-faq" class="text-2xl font-black text-gray-900 mb-4" style="letter-spacing:-0.02em">
        Preguntas frecuentes sobre obras en {zone.name}
      </h2>
      <p class="text-gray-600 leading-relaxed mb-8">
        Si tienes dudas sobre plazos, precios o qué incluye cada servicio en {zone.name}, aquí respondemos las más habituales. Si no encuentras la tuya, escríbenos o llámanos y te respondemos el mismo día.
      </p>
      <div class="divide-y divide-gray-200">
        {faqs.map(faq => (
          <details class="group py-5">
            <summary class="flex justify-between items-start gap-4 cursor-pointer list-none">
              <h3 class="font-semibold text-gray-900 text-base leading-snug m-0">{faq.q}</h3>
              <span class="text-[#A85535] text-2xl leading-none flex-shrink-0 group-open:rotate-45 transition-transform">+</span>
            </summary>
            <p class="mt-4 text-gray-500 leading-relaxed text-sm">{faq.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- ── CTA final — fondo oscuro (no terracota) ── -->
  <section class="py-16 bg-[#111827]" aria-labelledby="h-cta-final">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 text-center">
      <p class="font-black text-xs uppercase tracking-widest text-[#A85535] mb-4">Visita gratuita sin compromiso</p>
      <h2 id="h-cta-final" class="text-3xl font-black text-white mb-3" style="letter-spacing:-0.02em">
        ¿Necesitas presupuesto de obra en {zone.name}?
      </h2>
      <p class="mb-8 leading-relaxed" style="color:rgba(255,255,255,.6)">
        Presupuesto cerrado en 48h. Sin letra pequeña.
      </p>
      <a href="/contacto/" class="inline-block px-10 py-4 font-bold text-sm uppercase tracking-widest text-white hover:opacity-90 transition-opacity" style="background:#A85535">
        Solicitar valoración gratuita
      </a>
    </div>
  </section>

</Layout>

<style>
  /* Hero A — 2 columnas responsive */
  .hero-a-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
  }
  @media (min-width: 1024px) {
    .hero-a-grid {
      grid-template-columns: 9fr 7fr;
      gap: 5rem;
      align-items: center;
    }
  }

  /* Matriz tipológica — 3 columnas responsive */
  .matriz-grid {
    display: grid;
    grid-template-columns: 1fr;
  }
  @media (min-width: 768px) {
    .matriz-grid {
      grid-template-columns: repeat(3, 1fr);
    }
    .matriz-grid > div + div {
      border-left: 1px solid rgba(255, 255, 255, 0.06);
    }
  }

  /* Servicios editorial */
  .srv-item {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.75rem;
    padding: 2.25rem 0;
    border-top: 1px solid #e5e7eb;
  }
  .srv-item:last-child {
    border-bottom: 1px solid #e5e7eb;
  }
  @media (min-width: 768px) {
    .srv-item {
      grid-template-columns: 13rem 1fr;
      gap: 3rem;
      align-items: start;
    }
  }
  .srv-caso {
    font-size: 0.5625rem;
    font-weight: 900;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #a85535;
    line-height: 1.5;
    padding-top: 0.25rem;
  }
  .srv-link {
    font-size: 0.6875rem;
    font-weight: 700;
    color: #a85535;
    text-decoration: none;
    letter-spacing: 0.04em;
  }
  .srv-link:hover {
    text-decoration: underline;
  }
</style>
