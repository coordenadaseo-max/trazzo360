---
import { SITE } from '../../data/site';
import Btn from './Btn.astro';

/**
 * Par de CTAs del hero: acción principal y teléfono.
 *
 * El teléfono sale de SITE aquí dentro para que ninguna página tenga que
 * recordar el formato del `tel:`. Estilos en global.css (.hero-cta-*).
 */
interface Props {
  /** Texto del botón principal */
  label: string;
  href?: string;
  /** Línea pequeña bajo los botones, p. ej. "Sin compromiso" */
  note?: string;
}

const { label, href = '/contacto/', note } = Astro.props;
---

<div class="hero-cta-group">
  <Btn href={href} tam="lg" class="whitespace-nowrap">{label}</Btn>
  <Btn href={`tel:${SITE.phone}`} tam="lg" variante="secundaria" class="whitespace-nowrap">{SITE.phoneDisplay}</Btn>
  {note && (
    <p class="eyebrow eyebrow--min text-white/65">{note}</p>
  )}
</div>
