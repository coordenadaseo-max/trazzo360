              <th class="text-right py-3 px-5 font-bold text-gray-900">Peso sobre el total</th>
              <th class="text-left py-3 px-5 font-bold text-gray-900 hidden md:table-cell">Margen de ajuste</th>
            </tr>
          </thead>
          <tbody>
            <tr class="border-b border-gray-100">
              <td class="py-3 px-5 text-gray-700">Cocina (muebles, encimera, instalación)</td>
