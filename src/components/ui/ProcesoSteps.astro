---
interface Step {
  n: string;
  title: string;
  desc: string;
}
interface Props {
  steps: Step[];
  maxWidth?: string;
}
const { steps, maxWidth = '44rem' } = Astro.props;
---

<ol class="proceso-steps" style={`max-width:${maxWidth}`}>
  {steps.map(step => (
    <li class="proceso-step">
      {/* El <ol> ya anuncia la posición: el número es refuerzo visual. */}
      <span class="proceso-step__n" aria-hidden="true">{step.n}</span>
      <div>
        <h3 class="proceso-step__title">{step.title}</h3>
        <p class="proceso-step__desc">{step.desc}</p>
      </div>
    </li>
  ))}
</ol>
