        ].map(step => (
          <div class="bg-[#F9F7F4] p-7">
            <div class="text-4xl font-black text-gray-100 mb-4 leading-none">{step.n}</div>
            <h3 class="text-base font-bold text-gray-900 mb-2">{step.title}</h3>
            <p class="text-sm text-gray-600 leading-relaxed">{step.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Resultado cotidiano -->
  <div class="bg-white py-10">
    <div class="max-w-4xl mx-auto px-4">
      <p class="text-base text-gray-700 italic border-l-4 border-[#A85535] pl-5">
        Al mes de vivir en el piso reformado, la referencia del anterior desaparece. Lo que queda es la instalación eléctrica que aguanta el aire acondicionado sin disparar el diferencial, el agua caliente que llega sin esperar, la cocina donde cabe más de una persona, el suelo que no cruje. La reforma integral no cambia solo lo que se ve: cambia lo que se vive cada día.
      </p>
    </div>
  </div>

  <!-- Dónde hacemos reformas integrales -->
  <section class="py-16 bg-white" aria-labelledby="h-zonas">
    <div class="max-w-7xl mx-auto px-4">
      <h2 id="h-zonas" class="text-2xl font-black text-gray-900 mb-3" style="letter-spacing:-0.02em">
        Reformas integrales en el Corredor del Henares: todos los municipios
      </h2>
      <p class="text-gray-600 leading-relaxed mb-8 max-w-2xl">
        Hacemos reformas integrales en los ocho municipios del Corredor del Henares sin coste adicional de desplazamiento. Selecciona tu municipio para ver precios orientativos y los plazos habituales en tu zona.
      </p>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
        {zones.map(z => (
          <a href={`/reformas-integrales/${z.slug}/`} class="group block p-5 bg-[#F9F7F4] border-b-4 border-transparent hover:border-[#A85535] hover:shadow-md transition-all duration-200">
            <p class="text-sm font-bold text-gray-900 group-hover:text-[#A85535] transition-colors">Reformas integrales en {z.name}</p>
            <p class="text-xs text-gray-400 mt-1">Ver precios y plazos →</p>
          </a>
        ))}
      </div>
      <div class="mt-10 pt-8 border-t border-gray-100">
        <p class="text-sm text-gray-500 mb-4">Si solo necesitas reformar una zona de la vivienda:</p>
        <div class="flex flex-wrap gap-3">
          <a href="/servicios/reforma-banos/" class="inline-block px-4 py-2 text-sm font-medium text-gray-700 bg-gray-100 hover:bg-[#A85535] hover:text-white transition-all">Reforma de baños</a>
          <a href="/servicios/reforma-cocinas/" class="inline-block px-4 py-2 text-sm font-medium text-gray-700 bg-gray-100 hover:bg-[#A85535] hover:text-white transition-all">Reforma de cocinas</a>
          <a href="/servicios/reforma-pisos/" class="inline-block px-4 py-2 text-sm font-medium text-gray-700 bg-gray-100 hover:bg-[#A85535] hover:text-white transition-all">Reforma de pisos</a>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-20 bg-[#F9F7F4]" aria-labelledby="h-faq">
    <div class="max-w-4xl mx-auto px-4">
      <div class="mb-10">
        <p class="text-xs font-bold uppercase tracking-widest text-[#A85535] mb-3">Preguntas frecuentes</p>
        <h2 id="h-faq" class="text-3xl font-black text-gray-900 mb-3" style="letter-spacing:-0.02em">
          Todo lo que necesitas saber antes de una reforma integral
        </h2>
        <div class="w-12 h-1 bg-[#A85535]"></div>
      </div>
      <div class="divide-y divide-gray-200">
        {faqs.map(faq => (
          <details class="group py-5">
            <summary class="flex justify-between items-start gap-4 cursor-pointer list-none">
              <h3 class="font-semibold text-gray-900 text-base leading-snug m-0">{faq.q}</h3>
              <span class="text-[#A85535] text-2xl leading-none flex-shrink-0 group-open:rotate-45 transition-transform">+</span>
            </summary>
            <p class="mt-4 text-gray-500 leading-relaxed text-sm">{faq.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- M9 placeholder -->
  <!-- TODO: activar cuando haya fotografías reales de reformas integrales en el Corredor -->

  <!-- CTA Final -->
  <section class="py-20 bg-[#A85535]" aria-labelledby="h-cta-final">
    <div class="max-w-4xl mx-auto px-4 text-center">
      <h2 id="h-cta-final" class="text-3xl font-black text-white mb-3">
        ¿Cuánto cuesta reformar tu piso de manera integral?
      </h2>
      <p class="text-white/80 mb-3">Visita técnica gratuita. Presupuesto cerrado en 48h.</p>
      <p class="text-white/60 text-sm mb-8">Sin compromiso. El precio que firmamos es el precio que pagas.</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/contacto/" class="inline-block px-10 py-4 font-bold text-sm uppercase tracking-widest bg-white text-[#A85535] hover:bg-gray-100 transition-colors">Solicitar presupuesto</a>
        <a href={`tel:${SITE.phone}`} class="inline-block px-10 py-4 font-bold text-sm uppercase tracking-widest text-white border-2 border-white/40 hover:border-white transition-colors">☎ {SITE.phoneDisplay}</a>
      </div>
    </div>
  </section>

</Layout>
