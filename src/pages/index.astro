---
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import Layout from '../layouts/Layout.astro';
import { SITE, SERVICES, ZONES, AUTHOR, COMPROMISOS } from '../data/site';
import { SERVICE_ICONS } from '../data/site';

const publicDir = join(process.cwd(), 'public');
const hasRealProjectImages = false; // se activa cuando existan fotos reales de obra

const primaryZoneDescs: Record<string, string> = {
  'alcala-de-henares': 'Nuestra zona de mayor actividad. Trabajamos en toda la ciudad: El Val, El Ensanche, Nueva Alcalá y el centro histórico. Reformas integrales de pisos de los setenta y ochenta que necesitan instalaciones completamente nuevas, así como chalets y adosados en las urbanizaciones del extrarradio que buscan redistribución y acabados de calidad.',
  'torrejon-de-ardoz': 'La segunda ciudad donde más obras ejecutamos. El parque de vivienda de Torrejón concentra muchos pisos de los ochenta con instalaciones envejecidas que requieren reforma integral. Reformas de cocinas, baños y rehabilitación completa de viviendas son los trabajos más frecuentes.',
  'coslada': 'Reformas de pisos medianos donde cocinas y baños concentran la mayor parte del trabajo. Muchas viviendas de Coslada tienen un potencial de redistribución que aprovechamos sin ampliar el presupuesto. Visita técnica gratuita en toda la ciudad.',
  'san-fernando-de-henares': 'Reformas integrales de vivienda y trabajos en comunidades de vecinos: portales, escaleras y fachadas. San Fernando tiene un parque residencial de los años ochenta y noventa en buen estado estructural pero con instalaciones eléctricas y de fontanería que piden renovación completa.',
};

const faqs = [
  {
    q: '¿Cuánto puede costar reformar un piso de 100 m²?',
    a: 'Depende del alcance. Una reforma de acabados en un piso de 100 m² —suelos, pintura, baño, cocina, conservando las instalaciones existentes— oscila entre 30.000€ y 50.000€ (300–500 €/m²). Si las instalaciones necesitan renovación, el precio de una reforma integral esencial parte de 65.000€ (650 €/m²). Precios sin IVA; el presupuesto cerrado se entrega tras la visita técnica gratuita.',
  },
  {
    q: '¿Qué puedo reformar con 20.000€?',
    a: 'Con 20.000€ y las instalaciones en buen estado puedes hacer una reforma de acabados en un piso de 50–60 m²: baño completo, cocina con muebles, suelos nuevos y pintura general. Para una reforma integral con instalaciones nuevas de ese tamaño, el punto de partida está en 32.000–40.000€. En la visita gratuita determinamos el alcance real según el estado actual de la vivienda. Precios sin IVA.',
  },
  {
    q: '¿Qué es lo más caro en una reforma?',
    a: 'Las partidas más costosas son las instalaciones (fontanería y electricidad completas representan el 25–35% del presupuesto total), seguidas de los revestimientos (alicatados, pavimentos y carpintería). En una reforma integral, renovar las instalaciones ocultas es lo que más encarece porque requiere abrir paredes y suelos. Por eso el presupuesto tiene que contemplarlas antes de firmar, no descubrirlas a mitad de obra.',
  },
  {
    q: '¿Qué se puede reformar con 40.000€?',
    a: 'Con 40.000€ puedes hacer una reforma de acabados de alta calidad en un piso de 70–90 m² con instalaciones en buen estado: suelos, baño, cocina, carpintería y pintura. No alcanza para una reforma integral con instalaciones nuevas de ese tamaño, que parte de 45.500€ para 70 m² en calidad esencial. En la visita gratuita determinamos si las instalaciones permiten afrontar solo los acabados o si conviene contemplar la integral desde el principio. Precios sin IVA.',
  },
  {
    q: '¿Cuánto tarda una reforma integral en el Corredor del Henares?',
    a: 'Entre 8 y 14 semanas para un piso de 70–90 m². Fijamos la fecha de entrega en el contrato y la cumplimos. Si hay retrasos por causas propias, compensamos económicamente.',
  },
  {
    q: '¿Trabajáis en toda la zona del Corredor del Henares?',
    a: 'Sí. Cubrimos Alcalá de Henares, Torrejón de Ardoz, Coslada, San Fernando de Henares, Guadalajara, Azuqueca de Henares, Meco, Camarma de Esteruelas y municipios adyacentes. Profesionales de confianza en toda la zona, sin desplazamientos adicionales.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(f => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

// Compromisos clave para la sección de trust
const trustCompromisos = COMPROMISOS.filter(c =>
  ['contrato-escrito', 'pago-fases', 'garantia-ejecucion', 'imprevistos'].includes(c.id)
);
---

<Layout
  title="Reformas Corredor del Henares · Precio Cerrado | Trazzo360"
  description="Empresa de reformas en el Corredor del Henares con precio cerrado. Alcalá de Henares, Torrejón, Coslada, San Fernando. Presupuesto gratuito. Desde 2.800€."
  schema={faqSchema}
>

  <!-- ══════════════════════════════════════
       HERO — A2 · Tipográfico con sigilo
  ══════════════════════════════════════ -->
  <section class="bg-[#111827] hero-root flex flex-col justify-end" aria-labelledby="h-hero">
    <div class="max-w-7xl mx-auto px-4 lg:px-8 w-full">
      <!-- Sigilo: border-left terracota 4px mobile / 5px desktop.
           Único uso de acento lineal en esta sección. -->
      <div class="hero-sigil">
        <h1 id="h-hero" class="font-black text-white"
            style="font-size:clamp(2.75rem,9vw,8.5rem);letter-spacing:-0.04em;line-height:0.88;text-wrap:balance">
          Empresa de Reformas<br>en el Corredor<br>del Henares
        </h1>
      </div>
    </div>

    <!-- Zona de soporte -->
    <div class="max-w-7xl mx-auto px-4 lg:px-8 w-full" style="margin-top:clamp(2rem,4vw,3rem)">
      <div class="hero-support-border">
        <div class="hero-support-grid">

          <!-- Copy -->
          <p class="text-gray-400 leading-relaxed"
             style="font-size:clamp(0.875rem,1.4vw,1.0625rem);max-width:52ch">
            Una reforma se complica cuando las decisiones llegan tarde, los gremios trabajan sin coordinación o el presupuesto deja demasiadas cosas abiertas. En Trazzo360 planificamos y coordinamos reformas en el Corredor del Henares con un único responsable de obra, un presupuesto cerrado desde el inicio y una fecha de entrega que queda fijada en el contrato.
          </p>

          <!-- CTAs -->
          <div class="flex flex-col gap-3">
            <a href="/contacto/"
               class="inline-block text-center text-white font-black text-xs uppercase"
               style="padding:.9rem 1.5rem;background:#A85535;letter-spacing:.1em">
              Solicitar valoración gratuita
            </a>
            <a href={`tel:${SITE.phone}`}
               class="inline-block text-center font-black text-xs uppercase text-white"
               style="padding:.9rem 1.5rem;border:1px solid rgba(255,255,255,.25);letter-spacing:.1em">
              {SITE.phoneDisplay}
            </a>
            <p class="text-[10px] text-white/50 uppercase tracking-wider">Sin compromiso · Visita técnica gratuita</p>
          </div>

          <!-- Stats desktop -->
          <div class="text-right hidden lg:flex flex-col justify-end gap-5">
            <div>
              <p class="text-white font-black leading-none"
                 style="font-size:clamp(1.5rem,2.5vw,2rem);letter-spacing:-0.03em">2 años</p>
              <p style="font-size:10px;color:#9CA3AF;margin-top:4px;letter-spacing:.1em;text-transform:uppercase">Garantía sobre la ejecución</p>
            </div>
            <div>
              <p class="text-white font-black leading-none"
                 style="font-size:clamp(1.5rem,2.5vw,2rem);letter-spacing:-0.03em">1</p>
              <p style="font-size:10px;color:#9CA3AF;margin-top:4px;letter-spacing:.1em;text-transform:uppercase">Responsable de obra</p>
            </div>
            <div>
              <p class="text-white font-black leading-none"
                 style="font-size:clamp(1.5rem,2.5vw,2rem);letter-spacing:-0.03em">Precio cerrado</p>
              <p style="font-size:10px;color:#9CA3AF;margin-top:4px;letter-spacing:.1em;text-transform:uppercase">Por contrato desde el inicio</p>
            </div>
          </div>

        </div>

        <!-- Stats mobile -->
        <div class="flex gap-5 mt-8 lg:hidden">
          <div>
            <p class="text-white font-black" style="font-size:1.125rem;letter-spacing:-0.02em">2 años</p>
            <p style="font-size:10px;color:#9CA3AF;margin-top:2px;letter-spacing:.1em;text-transform:uppercase">Garantía</p>
          </div>
          <div>
            <p class="text-white font-black" style="font-size:1.125rem;letter-spacing:-0.02em">1</p>
            <p style="font-size:10px;color:#9CA3AF;margin-top:2px;letter-spacing:.1em;text-transform:uppercase">Responsable</p>
          </div>
          <div>
            <p class="text-white font-black" style="font-size:1.125rem;letter-spacing:-0.02em">Precio cerrado</p>
            <p style="font-size:10px;color:#9CA3AF;margin-top:2px;letter-spacing:.1em;text-transform:uppercase">Por contrato</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════
       SERVICIOS — 6 cards + índice SEO
  ══════════════════════════════════════ -->
  <section id="servicios" class="py-24 lg:py-32 bg-white" aria-labelledby="h-servicios">
    <div class="max-w-7xl mx-auto px-4">
      <div class="mb-12">
        <p class="text-xs font-bold uppercase tracking-widest text-[#A85535] mb-3">Nuestros servicios</p>
        <h2 id="h-servicios" class="text-4xl lg:text-5xl font-black text-gray-900 mb-5" style="letter-spacing:-0.02em">
          ¿Qué quieres reformar?
        </h2>
        <p class="text-lg text-gray-500 max-w-xl">Reformas integrales y parciales en Alcalá de Henares, Torrejón de Ardoz, Coslada y toda la zona del Corredor del Henares.</p>
      </div>

      <!-- 6 cards de servicio -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-px bg-gray-100 mb-12">
        {SERVICES.map(s => (
          <article class="group relative p-7 bg-white hover:bg-gray-50 transition-colors">
            <div class="w-8 h-8 text-[#A85535] mb-4">
              <Fragment set:html={SERVICE_ICONS[s.slug] ?? ''} />
            </div>
            <h3 class="text-base font-bold text-gray-900 mb-2 m-0">
              <a href={`/servicios/${s.slug}/`} class="after:absolute after:inset-0 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#A85535]">
                {s.title}
              </a>
            </h3>
            <p class="text-sm text-gray-500 leading-relaxed mb-4">{s.desc}</p>
            <p class="text-xs font-bold text-gray-400">
              Desde <span class="text-[#A85535] text-sm font-black">{s.priceFrom}€</span>
            </p>
          </article>
        ))}
      </div>

      <!-- Índice de reformas por zona: útil para el usuario, rastreable -->
      <nav aria-label="Reformas por tipo y zona" class="border-t border-gray-100 pt-8">
        <p class="text-xs font-bold uppercase tracking-widest text-gray-400 mb-4">
          También en tu zona
        </p>
        <ul class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-x-4 gap-y-2">
          {[
            { href: '/reformas-integrales/torrejon-de-ardoz/', label: 'Reforma integral en Torrejón de Ardoz' },
            { href: '/reformas-integrales/alcala-de-henares/', label: 'Reforma integral en Alcalá de Henares' },
            { href: '/reforma-banos/torrejon-de-ardoz/', label: 'Reforma de baño en Torrejón de Ardoz' },
            { href: '/reforma-banos/alcala-de-henares/', label: 'Reforma de baño en Alcalá de Henares' },
            { href: '/reforma-cocinas/torrejon-de-ardoz/', label: 'Reforma de cocina en Torrejón de Ardoz' },
            { href: '/reforma-cocinas/alcala-de-henares/', label: 'Reforma de cocina en Alcalá de Henares' },
            { href: '/reformas-integrales/coslada/', label: 'Reforma integral en Coslada' },
            { href: '/reforma-banos/coslada/', label: 'Reforma de baño en Coslada' },
            { href: '/reformas-integrales/guadalajara/', label: 'Reforma integral en Guadalajara' },
            { href: '/reforma-banos/guadalajara/', label: 'Reforma de baño en Guadalajara' },
            { href: '/reforma-pisos/torrejon-de-ardoz/', label: 'Reforma de piso en Torrejón de Ardoz' },
            { href: '/reforma-pisos/alcala-de-henares/', label: 'Reforma de piso en Alcalá de Henares' },
          ].map(link => (
            <li>
              <a href={link.href}
                 class="block text-xs text-gray-500 hover:text-[#A85535] transition-colors py-0.5 leading-snug">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>
  </section>

  <!-- ══════════════════════════════════════
       TRUST — Compromisos + responsable
       fusionados. Apertura con declaración
       tipográfica "1 único responsable de obra."
  ══════════════════════════════════════ -->
  <section id="nosotros" class="py-20 lg:py-28 bg-[#111827]" aria-labelledby="h-trust">
    <div class="max-w-7xl mx-auto px-4">

      <!-- Declaración de apertura: eje vertical -->
      <div style="border-bottom:1px solid rgba(255,255,255,.1);padding-bottom:3rem;margin-bottom:3.5rem">
        <p id="h-trust" class="font-black text-white"
           style="font-size:clamp(2rem,6vw,5rem);letter-spacing:-0.04em;line-height:0.9;text-wrap:balance">
          <span style="font-size:clamp(4rem,12vw,9rem);line-height:1">1</span>&thinsp;único
          responsable de obra.
        </p>
        <p style="font-size:clamp(0.875rem,1.4vw,1.0625rem);color:#9CA3AF;margin-top:1.25rem;max-width:52ch;line-height:1.65">
          Desde el primer presupuesto hasta la entrega de llaves.
          Un solo interlocutor coordina todos los gremios de tu reforma.
        </p>
      </div>

      <!-- Contenido: compromisos + responsable -->
      <div class="trust-content-grid">

        <!-- Compromisos -->
        <div>
          <p class="font-black uppercase text-white/30 mb-5"
             style="font-size:10px;letter-spacing:.15em">Lo que queda fijado en el contrato</p>
          <ul style="list-style:none;padding:0;margin:0">
            {trustCompromisos.map((c, i) => (
              <li style={`padding:1.25rem 0;${i < trustCompromisos.length - 1 ? 'border-bottom:1px solid rgba(255,255,255,.07)' : ''}`}>
                <p class="font-bold text-white text-sm mb-1">{c.title}</p>
                <p style="font-size:0.875rem;color:#9CA3AF;line-height:1.65;max-width:48ch">{c.short}</p>
              </li>
            ))}
          </ul>
          <div class="mt-8 flex gap-4 flex-wrap">
            <a href="/como-trabajamos/"
               class="inline-block text-white font-black text-xs uppercase"
               style="padding:.75rem 1.5rem;border:1px solid rgba(255,255,255,.2);letter-spacing:.1em">
              Ver todos los compromisos →
            </a>
            <a href="/calculadora-precio-reforma/"
               class="inline-block text-white/50 font-black text-xs uppercase hover:text-white transition-colors"
               style="padding:.75rem 1.5rem;letter-spacing:.1em">
              Calcular precio de mi reforma →
            </a>
          </div>
        </div>

        <!-- Cómo coordinamos — preparado para mostrar nombre cuando AUTHOR.name exista -->
        <div style="background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.07);padding:2rem">
          <p class="font-black uppercase text-white/30 mb-5"
             style="font-size:10px;letter-spacing:.15em">Cómo coordinamos tu reforma</p>

          {AUTHOR.name ? (
            <p class="font-bold text-white text-sm mb-1">{AUTHOR.name}</p>
            <p style="font-size:0.8125rem;color:#9CA3AF;margin-bottom:1rem">{AUTHOR.role}</p>
          ) : null}

          <ul style="list-style:none;padding:0;margin:0">
            {[
              'Una misma persona coordina la obra de principio a fin',
              'Interlocutor único: no hablas con gremios por separado',
              'Coordinación de albañiles, fontaneros y electricistas',
              'Seguimiento de plazos con comunicación constante',
              'Resolución de incidencias sin intermediarios',
            ].map((item, i, arr) => (
              <li style={`padding:.875rem 0;font-size:0.8125rem;color:#9CA3AF;line-height:1.55;${i < arr.length - 1 ? 'border-bottom:1px solid rgba(255,255,255,.06)' : ''}`}>
                {item}
              </li>
            ))}
          </ul>

          {/* PRE-LAUNCH BLOCKER: cifra de años pendiente confirmación titular */}
        </div>

      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════
       PRECIOS — Bands sin número display
  ══════════════════════════════════════ -->
  <section id="precios" class="py-20 lg:py-28 bg-[#F9F7F4]" aria-labelledby="h-precios">
    <div class="max-w-7xl mx-auto px-4">

      <div class="mb-10">
        <h2 id="h-precios" class="font-black text-gray-900 mb-4"
            style="font-size:clamp(1.75rem,4vw,2.75rem);letter-spacing:-0.025em;line-height:1.1;max-width:22ch;text-wrap:balance">
          ¿Cuánto cuesta una reforma en el Corredor del Henares?
        </h2>
        <p class="text-gray-600 max-w-prose" style="font-size:0.9375rem;line-height:1.7">
          Rangos orientativos calculados según superficie, alcance y nivel de calidad. El presupuesto cerrado que entregamos depende del estado actual, la superficie y los materiales elegidos. Siempre con precio fijado en el contrato.
        </p>
      </div>

      <!-- Bands de precio -->
      <div class="precio-bands-container mb-10">
        {[
          { servicio: 'Reforma de baño completo', nota: 'Hasta 4 m² · Cambio completo de instalación', rango: 'desde 2.800€' },
          { servicio: 'Reforma de cocina', nota: 'Hasta 8 m² · Sin obras de albañilería', rango: 'desde 5.000€' },
          { servicio: 'Reforma de acabados de vivienda', nota: '70 m² · Sin renovación de instalaciones', rango: 'desde 21.000€' },
          { servicio: 'Reforma integral de vivienda', nota: '70 m² · Con instalaciones nuevas', rango: 'desde 45.500€' },
          { servicio: 'Local comercial', nota: '50 m²', rango: 'desde 8.000€' },
          { servicio: 'Portal o comunidad de vecinos', nota: 'Escalera y zonas comunes', rango: 'desde 4.900€' },
        ].map(({ servicio, nota, rango }) => (
          <div class="precio-band-row">
            <div>
              <p class="font-bold text-gray-900 text-sm">{servicio}</p>
              <p class="text-gray-400 mt-0.5" style="font-size:0.75rem">{nota}</p>
            </div>
            <p class="font-black text-gray-900 precio-band-amount">
              {rango}
            </p>
          </div>
        ))}
      </div>

      <!-- Editorial + CTA -->
      <div style="border-left:3px solid #A85535;padding-left:1.5rem;margin-bottom:2rem">
        <p class="font-bold text-gray-900 text-sm mb-1">El precio que ves es el precio que firmas</p>
        <p class="text-gray-600" style="font-size:0.875rem;line-height:1.65;max-width:52ch">
          Sin cláusulas de ajuste ni imprevistos posteriores. El presupuesto cerrado que entregamos
          incluye materiales, mano de obra y gestión. Lo que aparece en el contrato es lo que se paga.
        </p>
      </div>
      <p class="text-xs text-gray-400 mb-6">Precios orientativos sin IVA. El presupuesto personalizado y gratuito es siempre más preciso.</p>
      <a href="/contacto/"
         class="inline-block text-white font-black text-xs uppercase"
         style="padding:1rem 2rem;background:#A85535;letter-spacing:.12em">
        Solicitar presupuesto cerrado
      </a>
    </div>
  </section>

  <!-- ══════════════════════════════════════
       PROCESO — 4 pasos
  ══════════════════════════════════════ -->
  <section id="proceso" class="py-24 lg:py-32 bg-[#F9F7F4]" aria-labelledby="h-proceso"
           style="border-top:1px solid #D1C9BD">
    <div class="max-w-7xl mx-auto px-4">
      <div class="mb-14">
        <p class="text-xs font-bold uppercase tracking-widest text-[#A85535] mb-3">Cómo trabajamos</p>
        <h2 id="h-proceso" class="font-black text-gray-900"
            style="font-size:clamp(1.75rem,4vw,2.75rem);letter-spacing:-0.02em;max-width:22ch;text-wrap:balance">
          Tu reforma en el Corredor, paso a paso
        </h2>
      </div>
      <ol class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8"
          style="list-style:none;padding:0;margin:0">
        {[
          { n: '01', title: 'Visita gratuita', desc: 'Visitamos tu vivienda en Alcalá, Torrejón, Coslada o cualquier municipio del Corredor sin ningún coste ni compromiso. Evaluamos el estado real de las instalaciones, tomamos medidas y escuchamos exactamente lo que quieres conseguir.' },
          { n: '02', title: 'Presupuesto cerrado', desc: 'Tras la visita, en un máximo de 48 horas recibes un presupuesto detallado con el precio final y el plazo de entrega cerrados. Sin letra pequeña, sin partidas abiertas. Lo que aparece en el documento que firmas es lo que vas a pagar.' },
          { n: '03', title: 'Ejecución con seguimiento', desc: 'Albañiles, fontaneros, electricistas y carpinteros ejecutan la obra con seguimiento diario y comunicación constante. Sabes en todo momento en qué punto está tu reforma y qué viene a continuación.' },
          { n: '04', title: 'Entrega con garantía', desc: 'Entregamos la obra limpia, revisada y en el plazo acordado. Recibes un certificado de garantía de 2 años sobre toda la ejecución. Si en ese periodo algo falla por nuestra parte, lo solucionamos sin coste adicional.' },
        ].map(step => (
          <li>
            <p class="font-black text-gray-200 mb-4" style="font-size:3.5rem;letter-spacing:-0.04em;line-height:1"
               aria-hidden="true">{step.n}</p>
            <h3 class="text-base font-bold text-gray-900 mb-3">{step.title}</h3>
            <p class="text-sm text-gray-500 leading-relaxed">{step.desc}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ══════════════════════════════════════
       ZONAS — "8 municipios. 1 empresa."
  ══════════════════════════════════════ -->
  <section id="zonas" class="py-24 lg:py-32 bg-[#111827]" aria-labelledby="h-zonas">
    <div class="max-w-7xl mx-auto px-4">

      <!-- Declaración territorial -->
      <div style="border-bottom:1px solid rgba(255,255,255,.1);padding-bottom:3rem;margin-bottom:3.5rem">
        <h2 id="h-zonas" class="font-black text-white"
