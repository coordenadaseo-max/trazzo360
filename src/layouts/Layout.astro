---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppBtn from '../components/WhatsAppBtn.astro';
import { SITE } from '../data/site';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  schema?: object | object[];
  ogImage?: string;
  robots?: string;
}

const { title, description, canonical, schema, ogImage, robots } = Astro.props;
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, SITE.url).toString();
const ogImageUrl = ogImage ?? `${SITE.url}/favicon.svg`;

// Noindex global mientras PUBLIC_SITE_INDEXING no esté activo en el entorno de producción.
// Para habilitar la indexación: establecer PUBLIC_SITE_INDEXING=true en el servidor de deploy.
const isIndexingEnabled = import.meta.env.PUBLIC_SITE_INDEXING === 'true';
const robotsMeta = robots ?? (!isIndexingEnabled ? 'noindex, nofollow' : undefined);

const baseSchema: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'GeneralContractor',
  '@id': `${SITE.url}/#business`,
  name: SITE.name,
  description: SITE.tagline,
  url: SITE.url,
  telephone: SITE.phone !== 'TU_TELEFONO' ? SITE.phone : undefined,
  email: SITE.email,
  priceRange: '€€',
  image: ogImageUrl,
  address: {
    '@type': 'PostalAddress',
    addressRegion: 'Comunidad de Madrid',
    addressCountry: 'ES',
  },
  areaServed: ['Alcalá de Henares', 'Torrejón de Ardoz', 'Coslada', 'San Fernando de Henares', 'Guadalajara', 'Azuqueca de Henares', 'Meco', 'Camarma de Esteruelas'],
  // PRE-LAUNCH BLOCKER: confirmar horario con titular antes de publicar en schema
  ...(SITE.phone !== 'TU_TELEFONO' ? { openingHoursSpecification: [
    { '@type': 'OpeningHoursSpecification', dayOfWeek: ['Monday','Tuesday','Wednesday','Thursday','Friday'], opens: '08:00', closes: '20:00' },
    { '@type': 'OpeningHoursSpecification', dayOfWeek: 'Saturday', opens: '09:00', closes: '14:00' },
  ]} : {}),
  ...(SITE.reviewCount > 0 ? {
    aggregateRating: {
      '@type': 'AggregateRating',
      ratingValue: SITE.ratingValue.toString(),
      reviewCount: SITE.reviewCount.toString(),
      bestRating: '5',
      worstRating: '1',
    },
  } : {}),
};

const schemas = [baseSchema, ...(schema ? (Array.isArray(schema) ? schema : [schema]) : [])];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Marca .js antes de pintar: los reveals sólo ocultan contenido si este
         script corrió. Va inline y sin type=module a propósito, para que se
         ejecute de forma síncrona y no haya parpadeo. -->
    <script is:inline>document.documentElement.classList.add('js');</script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="any" />

    <!-- Barlow Condensed: fuente display del sistema.
         Va aquí y no en cada página a propósito. Cuando la carga dependía de
         que cada página recordara incluirla, reforma-cocinas se quedó sin ella
         y su H1 renderizó en la fuente del sistema. El fallo era invisible en
         local porque el navegador la tenía cacheada de otra página. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@700;800;900&display=swap" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@700;800;900&display=swap" />

    {robotsMeta && <meta name="robots" content={robotsMeta} />}

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Schema JSON-LD -->
    {schemas.map(s => (
      <script type="application/ld+json" set:html={JSON.stringify(s)} />
    ))}
    <slot name="head" />
  </head>
  <body class="flex flex-col min-h-screen">
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
    {SITE.whatsapp !== 'TU_TELEFONO' && <WhatsAppBtn />}

    <!-- Reveals al hacer scroll. Va aquí y no en cada página: estaba duplicado
         en las 6 de servicios y ausente en las otras 68, que por eso mostraban
         todo el contenido de golpe.

         is:inline a propósito: si dependiera del bundle de Astro y este fallara
         o tardara, el contenido marcado con .reveal se quedaría invisible. Aquí
         se ejecuta sí o sí, y si el navegador no soporta IntersectionObserver
         se retira la marca .js y todo se ve sin animación. -->
    <!-- Parallax del hero. Estaba copiado literalmente en 5 páginas y faltaba
         en otras 3 que sí tienen imagen de hero, así que unas se movían y
         otras no. La escritura del transform va dentro de requestAnimationFrame:
         la versión anterior escribía estilos en cada evento de scroll. -->
    <script is:inline>
      (function () {
        var img = document.querySelector('.hero-img');
        if (!img || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        img.style.willChange = 'transform';
        var pendiente = false;
        window.addEventListener('scroll', function () {
          if (pendiente) return;
          pendiente = true;
          requestAnimationFrame(function () {
            img.style.transform = 'translateY(' + (window.scrollY * 0.28) + 'px)';
            pendiente = false;
          });
        }, { passive: true });
      })();
    </script>

    <script is:inline>
      (function () {
        if (!('IntersectionObserver' in window)) {
          document.documentElement.classList.remove('js');
          return;
        }
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (e) {
            if (e.isIntersecting) { e.target.classList.add('visible'); io.unobserve(e.target); }
          });
        }, { threshold: 0.1 });

        document.querySelectorAll('.reveal, .reveal-stagger').forEach(function (el) {
          // Lo que ya está en pantalla al cargar se muestra sin esperar al
          // observer: no debe animarse con retraso, y así el contenido visible
          // nunca queda a merced de que el observer dispare.
          var r = el.getBoundingClientRect();
          if (r.top < window.innerHeight && r.bottom > 0) { el.classList.add('visible'); return; }
          io.observe(el);
        });
      })();
    </script>
  </body>
</html>
