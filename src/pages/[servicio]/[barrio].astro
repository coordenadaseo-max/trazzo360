---
import Layout from '../../layouts/Layout.astro';
import { SITE, SERVICES, ZONES, RELATED_ZONES, SERVICE_ZONE_CONTENT, SERVICE_ZONE_META, SERVICE_ZONE_FAQS, SERVICE_ZONE_LEVEL } from '../../data/site';
import type { GetStaticPaths } from 'astro';
import FaqAccordion from '../../components/ui/FaqAccordion.astro';
import HeroTitle from '../../components/ui/HeroTitle.astro';

export const getStaticPaths: GetStaticPaths = () => {
  const staticOverrides = new Set(['reforma-cocinas/alcala-de-henares']);
  return SERVICES.flatMap(s =>
    ZONES
      .filter(z => !staticOverrides.has(`${s.slug}/${z.slug}`))
      .map(z => ({
        params: { servicio: s.slug, barrio: z.slug },
        props: { service: s, zone: z },
      }))
  );
};

const { service, zone } = Astro.props;

const TITLE_OVERRIDES: Record<string, Record<string, string>> = {
  'reforma-banos': {
    'torrejon-de-ardoz': 'Reforma de Baños en Torrejón · Precio Cerrado | Trazzo360',
    'alcala-de-henares':  'Reforma de Baños en Alcalá · Precio Cerrado | Trazzo360',
  },
  'reforma-pisos': {
    'torrejon-de-ardoz': 'Reforma de Pisos en Torrejón · Precio Cerrado | Trazzo360',
    'alcala-de-henares':  'Reforma de Pisos en Alcalá · Precio Cerrado | Trazzo360',
  },
  'comunidades-vecinos': {
    'san-fernando-de-henares': 'Comunidades de Propietarios en San Fernando | Trazzo360',
    'guadalajara':             'Comunidades de Propietarios en Guadalajara | Trazzo360',
  },
  'locales-comerciales': {
    'torrejon-de-ardoz': 'Local Comercial en Torrejón · Reformas | Trazzo360',
    'alcala-de-henares':  'Reforma de Locales Comerciales en Alcalá | Trazzo360',
  },
};

const titlePart = (service as any).titleBarrio ?? service.title;
const rawTitle = `${titlePart} en ${zone.name} | ${SITE.name}`;
const withPrecioCerrado = `${titlePart} en ${zone.name} · Precio Cerrado | ${SITE.name}`;
const pageTitle = TITLE_OVERRIDES[service.slug]?.[zone.slug]
  ?? (rawTitle.length >= 50 ? rawTitle : withPrecioCerrado.length <= 60 ? withPrecioCerrado : rawTitle);

const szc = SERVICE_ZONE_CONTENT[service.slug]?.[zone.slug];

const priceLbl: Record<string, string> = {
  'reformas-integrales': 'una reforma integral',
  'reforma-banos':       'reformar un baño',
  'reforma-cocinas':     'reformar una cocina',
  'reforma-pisos':       'reformar un piso',
  'locales-comerciales': 'reformar un local comercial',
  'comunidades-vecinos': 'una reforma de zonas comunes',
};
const costar = priceLbl[service.slug] ?? service.title.toLowerCase();

const priceFaq = {
  q: `¿Cuánto cuesta ${costar} en ${zone.name}?`,
  a: `${costar.charAt(0).toUpperCase() + costar.slice(1)} en ${zone.name} parte desde ${service.priceFrom}€ (${service.priceDesc}). El precio exacto depende del alcance y los materiales; lo recibes cerrado y sin letra pequeña tras la visita técnica gratuita.`,
};
const faqs = [priceFaq, ...(SERVICE_ZONE_FAQS[service.slug]?.[zone.slug] ?? [])];

// Agrupar body en secciones numeradas [h3 + p...]
type BodyBlock = { type: string; text: string; link?: { text: string; serviceSlug: string } };
const bodySource: BodyBlock[] = (szc?.body ?? service.body ?? []) as BodyBlock[];
const bodyGroups: { title: string; paras: BodyBlock[] }[] = [];
let currentGroup: { title: string; paras: BodyBlock[] } | null = null;
for (const block of bodySource) {
  if (block.type === 'h3') {
    currentGroup = { title: block.text, paras: [] };
    bodyGroups.push(currentGroup);
  } else if (block.type === 'p' && currentGroup) {
    currentGroup.paras.push(block);
  }
}

function renderBody(block: BodyBlock, zSlug: string): string {
  const lnk = block.link;
  if (!lnk) return block.text;
  const href = `/${lnk.serviceSlug}/${zSlug}/`;
  return block.text.replace(lnk.text, `<a href="${href}" class="text-[#A85535] hover:underline font-medium">${lnk.text}</a>`);
}

const relatedZoneSlugs: string[] = RELATED_ZONES[zone.slug] ?? [];
const otherZones = ZONES.filter(z => relatedZoneSlugs.includes(z.slug));
const relatedServiceSlugs: string[] = (service as any).relatedServices ?? [];
const relatedServices = SERVICES.filter(s => relatedServiceSlugs.includes(s.slug));

const pageSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: `${service.title} en ${zone.name}`,
  url: `${SITE.url}/${service.slug}/${zone.slug}/`,
  description: `${service.headline} Servicio en ${zone.name}. Precio cerrado, plazo garantizado y presupuesto gratuito.`,
  provider: { '@type': 'GeneralContractor', '@id': `${SITE.url}/#business`, name: SITE.name },
  areaServed: { '@type': 'City', name: zone.name },
  offers: { '@type': 'Offer', price: service.priceFrom, priceCurrency: 'EUR', description: service.priceDesc },
};
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(f => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio',       item: `${SITE.url}/` },
    { '@type': 'ListItem', position: 2, name: service.title,  item: `${SITE.url}/servicios/${service.slug}/` },
    { '@type': 'ListItem', position: 3, name: zone.name,      item: `${SITE.url}/${service.slug}/${zone.slug}/` },
  ],
};
---

<Layout
  title={pageTitle}
  description={SERVICE_ZONE_META[service.slug]?.[zone.slug] ?? `${service.title} en ${zone.name} desde ${service.priceFrom}€. Precio cerrado y presupuesto gratuito. ${SITE.name}.`}
  schema={[pageSchema, faqSchema, breadcrumbSchema]}
>

  <!-- Breadcrumb -->
  <nav aria-label="Migas de pan" class="bg-gray-50 border-b border-gray-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 py-3">
      <ol class="text-sm text-gray-500 flex items-center gap-2 flex-wrap" style="list-style:none;padding:0;margin:0">
        <li><a href="/" class="hover:text-[#A85535] transition-colors">Inicio</a></li>
        <li aria-hidden="true" class="text-gray-300">/</li>
        <li><a href={`/servicios/${service.slug}/`} class="hover:text-[#A85535] transition-colors">{service.title}</a></li>
        <li aria-hidden="true" class="text-gray-300">/</li>
        <li class="text-gray-800 font-medium" aria-current="page">{zone.name}</li>
      </ol>
    </div>
  </nav>

  <!-- ── 1. Hero ─────────────────────────────────────────────────────────── -->
  <section class="bg-[#111827] py-20 lg:py-28" aria-labelledby="h-hero">
    <div class="max-w-4xl mx-auto px-4 sm:px-6">

      <p class="font-bold block leading-snug mb-5" style="font-size:clamp(.75rem,1.35vw,.9375rem);letter-spacing:0.02em;color:rgba(255,255,255,.38)">
        {service.title} en {zone.name}
      </p>
      <HeroTitle lines={[`${titlePart} en ${zone.name}`]} size="clamp(2.25rem,5.5vw,4.25rem)" />

      <p class="leading-relaxed mt-7 max-w-2xl" style="font-size:1rem;color:rgba(255,255,255,.6)">
        {szc?.intro ?? service.headline}
      </p>

      <!-- Stats row -->
      <dl class="flex flex-wrap gap-x-8 gap-y-3 mt-8 pt-8" style="border-top:1px solid rgba(255,255,255,.08)">
        <div>
          <dt class="font-black text-xs uppercase tracking-widest" style="color:rgba(255,255,255,.3)">Desde</dt>
          <dd class="font-black text-white" style="font-size:1.5rem;letter-spacing:-0.02em">{service.priceFrom} €</dd>
          <dd class="font-bold text-xs" style="color:rgba(255,255,255,.3)">{service.priceDesc}</dd>
        </div>
        <div>
          <dt class="font-black text-xs uppercase tracking-widest" style="color:rgba(255,255,255,.3)">Precio</dt>
          <dd class="font-black text-white" style="font-size:1.5rem;letter-spacing:-0.02em">Cerrado</dd>
          <dd class="font-bold text-xs" style="color:rgba(255,255,255,.3)">por contrato</dd>
        </div>
        <div>
          <dt class="font-black text-xs uppercase tracking-widest" style="color:rgba(255,255,255,.3)">Garantía</dt>
          <dd class="font-black text-white" style="font-size:1.5rem;letter-spacing:-0.02em">2 años</dd>
          <dd class="font-bold text-xs" style="color:rgba(255,255,255,.3)">sobre la ejecución</dd>
        </div>
      </dl>

      <div class="flex flex-col sm:flex-row gap-3 mt-8">
        <a href="/contacto/" class="inline-block text-center px-7 py-3.5 font-black text-xs uppercase tracking-widest text-white hover:opacity-90 transition-opacity" style="background:#A85535">
          Solicitar visita técnica gratuita
        </a>
        <a href={`tel:${SITE.phone}`} class="inline-block text-center px-7 py-3.5 font-black text-xs uppercase tracking-widest text-white border border-white/20 hover:border-white/50 transition-colors">
          {SITE.phoneDisplay}
        </a>
      </div>
    </div>
  </section>

  <!-- ── 2. Contenido editorial ─────────────────────────────────────────── -->
  {bodyGroups.length > 0 && (
    <section class="py-20 bg-white" aria-labelledby="h-contenido">
      <div class="max-w-4xl mx-auto px-4 sm:px-6">

        <p class="font-black text-xs uppercase tracking-widest text-[#A85535] mb-4">Antes de presupuestar</p>
        <h2 id="h-contenido" class="h4-block mb-6 reveal" style="letter-spacing:-0.02em">
          {service.title} en {zone.name}: qué se evalúa antes de cerrar el precio
        </h2>

        {bodyGroups.map((group, i) => (
          <div class={`cond-item${i === bodyGroups.length - 1 ? ' cond-item--last' : ''}`}>
            <div class="cond-num">{String(i + 1).padStart(2, '0')}</div>
            <div>
              <h3 class="font-bold text-gray-900 mb-2" style="font-size:1.0625rem">{group.title}</h3>
              {group.paras.map(p => (
                p.link
                  ? <p class="text-gray-500 leading-relaxed mt-3" style="font-size:.9375rem" set:html={renderBody(p, zone.slug)} />
                  : <p class="text-gray-500 leading-relaxed mt-3" style="font-size:.9375rem">{p.text}</p>
              ))}
            </div>
          </div>
        ))}

      </div>
    </section>
  )}

  <!-- ── 3. Precio orientativo ────────────────────────────────────────────── -->
  {service.priceTable && (service.priceTable as {label:string;price:string;includes?:string}[]).length > 0 && (
    <section class="py-16 bg-[#F9F7F4]" aria-labelledby="h-precio">
      <div class="max-w-4xl mx-auto px-4 sm:px-6">

        <p class="font-black text-xs uppercase tracking-widest text-[#A85535] mb-4">Precio orientativo</p>
        <h2 id="h-precio" class="h4-block mb-2 reveal" style="letter-spacing:-0.02em">
          ¿Cuánto cuesta {costar} en {zone.name}?
        </h2>
        <p class="text-gray-500 leading-relaxed mb-8" style="font-size:.9375rem">
          El precio exacto depende del alcance, los materiales y el estado de las instalaciones previas. Lo recibes por escrito tras la visita técnica gratuita.
        </p>

        <div class="overflow-x-auto">
          <table class="w-full border border-gray-100 border-collapse text-sm">
            <caption class="sr-only">Precios orientativos de {costar} en {zone.name}</caption>
            <thead>
              <tr class="bg-[#111827]">
                <th scope="col" class="text-left text-xs font-bold uppercase tracking-widest text-gray-400 px-6 py-4">Tipo de obra</th>
                <th scope="col" class="text-left text-xs font-bold uppercase tracking-widest text-gray-400 px-6 py-4">Qué incluye</th>
                <th scope="col" class="text-right text-xs font-bold uppercase tracking-widest text-gray-400 px-6 py-4 whitespace-nowrap">Precio orientativo</th>
              </tr>
            </thead>
            <tbody>
              {(service.priceTable as {label:string;price:string;includes?:string}[]).map(row => (
                <tr class="border-t border-gray-100 bg-white">
                  <th scope="row" class="text-left px-6 py-5 font-semibold text-gray-900 whitespace-nowrap align-top">{row.label}</th>
                  <td class="px-6 py-5 text-gray-500 align-top">{row.includes ?? '—'}</td>
                  <td class="px-6 py-5 text-right font-black text-[#A85535] whitespace-nowrap align-top">{row.price}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <p class="text-xs text-gray-400 mt-4">
          Sin IVA. El precio exacto se fija tras la visita técnica gratuita.
        </p>
        <div class="flex flex-wrap gap-5 mt-6">
          <a href={`/servicios/${service.slug}/#precios`} class="text-sm font-bold text-[#A85535] hover:underline">
            Ver tabla completa de precios →
          </a>
          <a href={`/calculadora-precio-reforma/?servicio=${service.slug}`} class="text-sm font-bold text-[#A85535] hover:underline">
            Calculadora de precio orientativo →
          </a>
        </div>
      </div>
    </section>
  )}

  <!-- ── 4. Barrios ─────────────────────────────────────────────────────── -->
  <section class="py-14 bg-white" aria-labelledby="h-barrios">
    <div class="max-w-4xl mx-auto px-4 sm:px-6">
      <h2 id="h-barrios" class="text-lg font-black text-gray-900 mb-2" style="letter-spacing:-0.01em">
        Zonas de {zone.name} donde trabajamos
      </h2>
      <p class="text-sm text-gray-500 mb-5">
        Cubrimos todos los barrios y urbanizaciones de {zone.name} sin recargo por desplazamiento.
      </p>
      <ul class="flex flex-wrap gap-2" style="list-style:none;padding:0;margin:0">
        {zone.neighborhoods.map((n: string) => (
          <li class="inline-block px-3 py-1.5 bg-gray-50 border border-gray-200 text-sm text-gray-700 font-medium">{n}</li>
        ))}
        <li class="inline-block px-3 py-1.5 bg-gray-50 border border-dashed border-gray-300 text-sm text-gray-400">
          ¿Tu zona no aparece? Consúltanos
        </li>
      </ul>
    </div>
  </section>

  <!-- ── 5. FAQ ──────────────────────────────────────────────────────────── -->
  <section class="py-20 bg-[#F9F7F4]" aria-labelledby="h-faq">
    <div class="max-w-4xl mx-auto px-4 sm:px-6">

      <p class="font-black text-xs uppercase tracking-widest text-[#A85535] mb-4">Preguntas frecuentes</p>
      <h2 id="h-faq" class="h4-block mb-2 reveal" style="letter-spacing:-0.02em">
        Dudas habituales sobre {costar} en {zone.name}
      </h2>
      <p class="text-gray-500 leading-relaxed mb-8" style="font-size:.9375rem">
        Si no encuentras tu duda aquí, escríbenos o llámanos. Respondemos el mismo día.
      </p>

      <FaqAccordion faqs={faqs} />
    </div>
  </section>

  <!-- ── 6. Navegación secundaria ─────────────────────────────────────────── -->
  <nav aria-label="Páginas relacionadas" class="py-8 bg-[#F9F7F4] border-t border-gray-200">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 flex flex-wrap items-center gap-x-8 gap-y-3">
      <span class="text-xs font-bold uppercase tracking-widest text-gray-400 flex-shrink-0">Ver también</span>
      <a href={`/servicios/${service.slug}/`} class="text-sm text-gray-500 hover:text-[#A85535] transition-colors">
        {service.title} en el Corredor del Henares
      </a>
      <a href={`/zonas/${zone.slug}/`} class="text-sm text-gray-500 hover:text-[#A85535] transition-colors">
        Empresa de reformas en {zone.name}
      </a>
      {relatedServices.map(s => (
        <a href={`/${s.slug}/${zone.slug}/`} class="text-sm text-gray-500 hover:text-[#A85535] transition-colors">
          {s.anchorLabel} en {zone.name}
        </a>
      ))}
      {otherZones.slice(0, 3).map(z => (
        <a href={`/${service.slug}/${z.slug}/`} class="text-sm text-gray-500 hover:text-[#A85535] transition-colors">
          {service.anchorLabel} en {z.name}
        </a>
      ))}
    </div>
  </nav>

  <!-- ── 7. CTA final ──────────────────────────────────────────────────── -->
  <section class="py-16 bg-[#111827]" aria-labelledby="h-cta-final">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 text-center">
      <p class="font-black text-xs uppercase tracking-widest text-[#A85535] mb-4">Visita técnica gratuita</p>
      <h2 id="h-cta-final" class="h3-sub h3-sub--dark mb-3 reveal" style="letter-spacing:-0.02em">
        ¿{service.title} en {zone.name}?
      </h2>
      <p class="leading-relaxed mb-8" style="color:rgba(255,255,255,.6)">
        La visita técnica evalúa el estado previo antes de cerrar ningún número. Presupuesto cerrado por escrito. Sin letra pequeña.
      </p>
      <a href="/contacto/" class="inline-block px-10 py-4 font-bold text-sm uppercase tracking-widest text-white hover:opacity-90 transition-opacity" style="background:#A85535">
        Solicitar visita técnica gratuita
      </a>
    </div>
  </section>

</Layout>

<style>
  /* Condicionantes — layout editorial 2 columnas */
  .cond-item {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    padding: 2rem 0;
    border-bottom: 1px solid #e5e7eb;
  }
  .cond-item--last {
    border-bottom: none;
    padding-bottom: 0;
  }
  @media (min-width: 768px) {
    .cond-item {
      grid-template-columns: 3rem 1fr;
      gap: 2rem;
      align-items: start;
    }
  }
  .cond-num {
    font-size: .625rem;
    font-weight: 900;
    letter-spacing: .12em;
    color: #a85535;
    padding-top: .3rem;
  }
</style>
