            <p class="mt-4 text-gray-500 leading-relaxed text-sm">{faq.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA Final -->
  <section class="py-20 bg-[#111827]" aria-labelledby="h-cta-final">
    <div class="max-w-4xl mx-auto px-4 text-center">
      <h2 id="h-cta-final" class="text-3xl font-black text-white mb-3">
        ¿Cuánto cuesta reformar tu local o tu oficina?
      </h2>
      <p class="text-white/80 mb-3">Visita técnica gratuita. Presupuesto cerrado por escrito.</p>
      <p class="text-white/60 text-sm mb-8">El precio que firmamos es el que pagas.</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/contacto/" class="inline-block px-10 py-4 font-bold text-sm uppercase tracking-widest bg-[#A85535] text-white hover:bg-[#8A4229] transition-colors">Solicitar presupuesto</a>
        <a href={`tel:${SITE.phone}`} class="inline-block px-10 py-4 font-bold text-sm uppercase tracking-widest text-white border-2 border-white/40 hover:border-white transition-colors">☎ {SITE.phoneDisplay}</a>
      </div>
    </div>
  </section>

</Layout>
