  .fase-pause-btn { position:absolute; top:0; right:0; z-index:2; display:flex; align-items:center; justify-content:center; width:2rem; height:2rem; color:#9CA3AF; background:#fff; border:1px solid #D1D5DB; cursor:pointer; transition:border-color 0.2s, color 0.2s; }
  .fase-pause-btn:hover { border-color:#A85535; color:#A85535; }
