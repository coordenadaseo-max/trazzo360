---
interface Props {
  serviceSlug: string;
  serviceLabel: string;
}
const { serviceSlug, serviceLabel } = Astro.props;

const ZONES = [
  { name: 'Torrejón de Ardoz',       slug: 'torrejon-de-ardoz' },
  { name: 'Alcalá de Henares',       slug: 'alcala-de-henares' },
  { name: 'Coslada',                 slug: 'coslada' },
  { name: 'San Fernando de Henares', slug: 'san-fernando-de-henares' },
  { name: 'Guadalajara',             slug: 'guadalajara' },
  { name: 'Azuqueca de Henares',     slug: 'azuqueca-de-henares' },
  { name: 'Meco',                    slug: 'meco' },
  { name: 'Camarma de Esteruelas',   slug: 'camarma-de-esteruelas' },
];
---

<div class="zonas-grid">
  {ZONES.map(z => (
    <article class="zona-card relative">
      <h3 class="zona-card__title">
        <a
          href={`/${serviceSlug}/${z.slug}/`}
          class="after:absolute after:inset-0 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand"
        >
          {serviceLabel} en {z.name}
        </a>
      </h3>
      <span aria-hidden="true" class="zona-card__sub">Ver precios →</span>
    </article>
  ))}
</div>
