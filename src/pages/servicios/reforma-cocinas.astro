      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {[
          { n: '01', title: 'Visita técnica y diseño', desc: 'Medimos la cocina y diseñamos la distribución óptima. Selección de materiales, muebles y electrodomésticos con tu supervisión directa.' },
          { n: '02', title: 'Presupuesto cerrado en 48h', desc: 'Presupuesto detallado con todas las partidas incluidas: diseño, instalaciones, muebles, electrodomésticos, gestión de escombros y limpieza.' },
          { n: '03', title: 'Pedido de materiales', desc: 'Una vez firmado el contrato, pedimos todos los materiales: muebles, encimera y electrodomésticos. La obra no empieza hasta tener confirmada la disponibilidad.' },
          { n: '04', title: 'Desescombro e instalaciones', desc: 'Demolición del estado anterior. Instalación eléctrica con circuitos dedicados, fontanería y alicatado de zona de trabajo.' },
          { n: '05', title: 'Montaje de muebles y acabados', desc: 'Montaje de muebles altos y bajos, encimera, fregadero, grifo y electrodomésticos. Ajuste y nivelación final.' },
          { n: '06', title: 'Entrega y garantía', desc: 'Revisión final contigo, limpieza a fondo y entrega con garantía de 2 años sobre la ejecución.' },
        ].map(step => (
          <div class="bg-[#F9F7F4] p-7">
            <div class="text-4xl font-black text-gray-100 mb-4 leading-none">{step.n}</div>
            <h3 class="text-base font-bold text-gray-900 mb-2">{step.title}</h3>
            <p class="text-sm text-gray-600 leading-relaxed">{step.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Resultado cotidiano -->
  <div class="bg-white py-10">
    <div class="max-w-4xl mx-auto px-4">
      <p class="text-base text-gray-700 italic border-l-4 border-[#A85535] pl-5">
        La primera semana de usar la cocina nueva, la referencia de la anterior desaparece. Lo que queda es la encimera que no acumula grasa en las juntas, la campana que calla en cuanto dejas de cocinar, el cajón de los cubiertos que abre y cierra sin trabarse. La cocina es el espacio donde más horas se pasan sin contarlas. Eso es lo que cambia una reforma bien planificada.
      </p>
    </div>
  </div>

  <!-- Dónde hacemos reforma de cocinas -->
  <section class="py-16 bg-white" aria-labelledby="h-zonas">
    <div class="max-w-7xl mx-auto px-4">
      <h2 id="h-zonas" class="text-2xl font-black text-gray-900 mb-3" style="letter-spacing:-0.02em">
        Reforma de cocinas en el Corredor del Henares: todos los municipios
      </h2>
      <p class="text-gray-600 leading-relaxed mb-8 max-w-2xl">
        Hacemos reformas de cocinas en los ocho municipios del Corredor sin coste adicional de desplazamiento. Selecciona tu municipio para ver información específica de tu zona.
      </p>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
        {zones.map(z => (
          <a href={`/reforma-cocinas/${z.slug}/`} class="group block p-5 bg-[#F9F7F4] border-b-4 border-transparent hover:border-[#A85535] hover:shadow-md transition-all duration-200">
            <p class="text-sm font-bold text-gray-900 group-hover:text-[#A85535] transition-colors">Reforma de cocinas en {z.name}</p>
            <p class="text-xs text-gray-400 mt-1">Ver precios y plazos →</p>
          </a>
        ))}
      </div>
      <div class="mt-10 pt-8 border-t border-gray-100">
        <p class="text-sm text-gray-500 mb-4">Si tu reforma de cocina va unida a otras zonas de la vivienda:</p>
        <div class="flex flex-wrap gap-3">
          <a href="/servicios/reforma-banos/" class="inline-block px-4 py-2 text-sm font-medium text-gray-700 bg-gray-100 hover:bg-[#A85535] hover:text-white transition-all">Reforma de baños</a>
          <a href="/servicios/reforma-pisos/" class="inline-block px-4 py-2 text-sm font-medium text-gray-700 bg-gray-100 hover:bg-[#A85535] hover:text-white transition-all">Reforma de pisos y viviendas</a>
          <a href="/servicios/reformas-integrales/" class="inline-block px-4 py-2 text-sm font-medium text-gray-700 bg-gray-100 hover:bg-[#A85535] hover:text-white transition-all">Reformas integrales</a>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-20 bg-[#F9F7F4]" aria-labelledby="h-faq">
    <div class="max-w-4xl mx-auto px-4">
      <div class="mb-10">
        <p class="text-xs font-bold uppercase tracking-widest text-[#A85535] mb-3">Preguntas frecuentes</p>
        <h2 id="h-faq" class="text-3xl font-black text-gray-900 mb-3" style="letter-spacing:-0.02em">
          Todo lo que necesitas saber antes de reformar la cocina
        </h2>
        <div class="w-12 h-1 bg-[#A85535]"></div>
      </div>
      <div class="divide-y divide-gray-200">
        {faqs.map(faq => (
          <details class="group py-5">
            <summary class="flex justify-between items-start gap-4 cursor-pointer list-none">
              <h3 class="font-semibold text-gray-900 text-base leading-snug m-0">{faq.q}</h3>
              <span class="text-[#A85535] text-2xl leading-none flex-shrink-0 group-open:rotate-45 transition-transform">+</span>
            </summary>
            <p class="mt-4 text-gray-500 leading-relaxed text-sm">{faq.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA Final -->
  <section class="py-20 bg-[#A85535]" aria-labelledby="h-cta-final">
    <div class="max-w-4xl mx-auto px-4 text-center">
      <h2 id="h-cta-final" class="text-3xl font-black text-white mb-3">
        ¿Cuánto cuesta reformar tu cocina?
      </h2>
      <p class="text-white/80 mb-3">Visita técnica gratuita. Diseño y presupuesto cerrado en 48h.</p>
      <p class="text-white/60 text-sm mb-8">Sin compromiso. El precio que firmamos es el precio que pagas.</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/contacto/" class="inline-block px-10 py-4 font-bold text-sm uppercase tracking-widest bg-white text-[#A85535] hover:bg-gray-100 transition-colors">Solicitar presupuesto</a>
        <a href={`tel:${SITE.phone}`} class="inline-block px-10 py-4 font-bold text-sm uppercase tracking-widest text-white border-2 border-white/40 hover:border-white transition-colors">☎ {SITE.phoneDisplay}</a>
      </div>
    </div>
  </section>

</Layout>
