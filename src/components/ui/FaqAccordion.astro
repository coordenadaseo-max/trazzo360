---
interface FAQ {
  q: string;
  a: string;
}
interface Grupo {
  titulo: string;
  faqs: FAQ[];
}
interface Props {
  faqs?: FAQ[];
  /** Alternativa a `faqs`: agrupa por tema. Para FAQs largas, donde doce títulos
      seguidos que empiezan igual son un muro y no una ayuda. Cambia la jerarquía:
      el grupo toma el <h3> y las preguntas bajan a <h4>. */
  grupos?: Grupo[];
  /** Abre la primera por defecto: es la más buscada y evita que el bloque
      se muestre como una lista de títulos sin una sola respuesta visible. */
  abrirPrimera?: boolean;
}
const { faqs, grupos, abrirPrimera = true } = Astro.props;

if (!faqs && !grupos) throw new Error('FaqAccordion: hay que pasar `faqs` o `grupos`.');

// Un solo recorrido para las dos formas: sin grupos, un grupo sin título.
const bloques: Grupo[] = grupos ?? [{ titulo: '', faqs: faqs! }];
const Pregunta = grupos ? 'h4' : 'h3';
let indiceGlobal = 0;
---

{bloques.map(bloque => (
<div class="faq-list">
  {bloque.titulo && <h3 class="faq-grupo">{bloque.titulo}</h3>}
  {bloque.faqs.map(faq => {
    const primera = indiceGlobal++ === 0;
    return (
    <details class="faq-item" open={abrirPrimera && primera}>
      <summary class="faq-summary">
        <Pregunta class="faq-q">{faq.q}</Pregunta>
        <svg class="faq-chevron" width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <path d="M5 7.5L10 12.5L15 7.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </summary>
      <div class="faq-body">
        <p class="faq-a">{faq.a}</p>
      </div>
    </details>
    );
  })}
</div>
))}
