---
interface Props {
  id: string;
  title: string;
  subtitle?: string;
  eyebrow?: string;
  size?: 'lg' | 'md';
  mb?: string;
}
const { id, title, subtitle, eyebrow, size = 'lg', mb = 'mb-10' } = Astro.props;
// Clases de rol de global.css, no estilos inline repetidos.
const headingClass = size === 'md' ? 'h3-sub' : 'h2-section';
---

<div class:list={['reveal', mb]}>
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <h2 id={id} class:list={[headingClass, 'mb-5']}>{title}</h2>
  {subtitle && (
    <p class="text-gray-600 leading-relaxed measure-wide" style="font-size:1.0625rem;line-height:1.75">
      {subtitle}
    </p>
  )}
</div>
