            <h3 class="text-sm font-bold text-gray-900 group-hover:text-[#A85535] transition-colors m-0">
              <a href={`/locales-comerciales/${z.slug}/`} class="after:absolute after:inset-0 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#A85535]">
