            <p class="text-sm text-gray-600 leading-relaxed">{step.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Dónde hacemos reforma de locales -->
  <section class="py-16 bg-white" aria-labelledby="h-zonas">
    <div class="max-w-7xl mx-auto px-4">
      <h2 id="h-zonas" class="text-2xl font-black text-gray-900 mb-3" style="letter-spacing:-0.02em">
        Reforma de locales y oficinas en el Corredor: todos los municipios
      </h2>
      <p class="text-gray-600 leading-relaxed mb-8 max-w-2xl">
        Reformamos locales comerciales y oficinas en los ocho municipios del Corredor del Henares sin coste adicional de desplazamiento. Selecciona tu municipio para ver información específica sobre licencias y plazos en tu zona.
      </p>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
