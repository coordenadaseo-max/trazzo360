---
import { existsSync } from 'node:fs';
import { join } from 'node:path';

interface Props {
  src: string;       // ruta relativa a /public, ej: '/img/proyectos/bano-antes.jpg'
  alt: string;
  label: string;     // 'Antes' | 'Después'
  labelBg?: string;  // fondo del badge de etiqueta (CSS color)
  service?: string;  // texto secundario en el fallback
}

const {
  src,
  alt,
  label,
  labelBg = 'rgba(0,0,0,0.65)',
  service = '',
} = Astro.props;

const publicDir = join(process.cwd(), 'public');
const relativePath = src.startsWith('/') ? src.slice(1) : src;
const exists = existsSync(join(publicDir, relativePath));
---

<div class="relative aspect-[4/3] overflow-hidden">
  <span
    class="absolute top-0 left-0 text-white text-xs font-bold px-3 py-1.5 uppercase tracking-wider z-10"
    style={`background:${labelBg}`}
  >{label}</span>

  {exists ? (
    <img
      src={src}
      alt={alt}
      class="w-full h-full object-cover"
      loading="lazy"
    />
  ) : (
    <div class="absolute inset-0 flex flex-col items-center justify-center gap-2 bg-[#1a1f2e]">
      <svg class="w-10 h-10 text-gray-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
      </svg>
      {service && <p class="text-xs text-gray-500 font-medium text-center px-4">{service}</p>}
      <p class="text-xs text-gray-600">Foto pendiente</p>
    </div>
  )}
</div>
