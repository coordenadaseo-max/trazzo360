---
/**
 * Chip de enlace a una guía o servicio relacionado.
 * El bloque más repetido del sitio: ~100 usos, cada uno duplicando el SVG.
 *
 * Los estilos viven en global.css (.price-guide-chip). Aquí sólo el markup.
 */
interface Props {
  href: string;
  /** Categoría del destino: "Guía", "Servicio", "Zona"… */
  label: string;
  /** Texto visible del enlace */
  text: string;
}

const { href, label, text } = Astro.props;
---

<a href={href} class="price-guide-chip">
  <span class="price-guide-chip__label">{label}</span>
  <span class="price-guide-chip__text">{text}</span>
  <svg class="price-guide-chip__arrow" width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
    <path d="M2.5 6h7M6.5 3l3 3-3 3" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" />
  </svg>
</a>
