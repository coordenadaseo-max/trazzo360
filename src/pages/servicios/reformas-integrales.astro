<script>
  // Hero parallax
  const heroImgEl = document.querySelector('.hero-img') as HTMLElement;
  if (heroImgEl && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    heroImgEl.style.willChange = 'transform';
    window.addEventListener('scroll', () => {
      heroImgEl.style.transform = `translateY(${window.scrollY * 0.28}px)`;
    }, { passive: true });
  }

  // Scroll reveals
  const io = new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) { e.target.classList.add('visible'); io.unobserve(e.target); }
    });
  }, { threshold: 0.1 });
  document.querySelectorAll('.reveal, .reveal-stagger').forEach(el => io.observe(el));

  // Count-up for [data-count]
  function countUp(el: HTMLElement) {
    const target = parseFloat((el as HTMLElement & { dataset: { count: string; suffix?: string } }).dataset.count);
    const suffix = (el as HTMLElement & { dataset: { suffix?: string } }).dataset.suffix || '';
    const dur = 1100;
    const start = performance.now();
    const tick = (now: number) => {
      const p = Math.min((now - start) / dur, 1);
      const eased = 1 - Math.pow(1 - p, 3);
      el.textContent = Math.round(target * eased).toLocaleString('es-ES') + suffix;
      if (p < 1) requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);
  }
  const cio = new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) { countUp(e.target as HTMLElement); cio.unobserve(e.target); }
    });
  }, { threshold: 0.5 });
  document.querySelectorAll('[data-count]').forEach(el => cio.observe(el));

  // Dynamic phase carousel
  const faseCards = document.querySelectorAll('.fase-card');
  if (faseCards.length) {
    let current = 0;
    let isPaused = false;
    const PHASE_DURATION = 3500;
    const liveRegion = document.getElementById('fase-live') as HTMLElement;
    const pauseBtn = document.getElementById('fase-pause-btn') as HTMLButtonElement;

    function activateFase(idx: number) {
      faseCards.forEach(c => {
        c.classList.remove('is-active');
        const bar = c.querySelector('.fase-bar') as HTMLElement;
        if (bar) { bar.style.transition = 'none'; bar.style.width = '0'; }
      });
      const card = faseCards[idx];
      card.classList.add('is-active');
      const bar = card.querySelector('.fase-bar') as HTMLElement;
      if (bar) {
        requestAnimationFrame(() => {
          bar.style.transition = `width ${PHASE_DURATION}ms linear`;
          bar.style.width = '100%';
        });
      }
      if (liveRegion) {
        const label = card.querySelector('.fase-label');
        if (label) liveRegion.textContent = `Fase activa: ${label.textContent}`;
      }
    }

    function startTimer() {
      return setInterval(() => {
        current = (current + 1) % faseCards.length;
        activateFase(current);
      }, PHASE_DURATION);
    }

    activateFase(0);
    let timer = startTimer();

    // Pause button toggle
    if (pauseBtn) {
      pauseBtn.addEventListener('click', () => {
        isPaused = !isPaused;
        pauseBtn.setAttribute('aria-pressed', String(isPaused));
        pauseBtn.setAttribute('aria-label', isPaused ? 'Reanudar animación de fases' : 'Pausar animación de fases');
        if (isPaused) {
          clearInterval(timer);
        } else {
          timer = startTimer();
        }
      });
    }

    // Pause on hover
    const faseGrid = document.getElementById('fase-grid');
    if (faseGrid) {
      faseGrid.addEventListener('mouseenter', () => { if (!isPaused) clearInterval(timer); });
      faseGrid.addEventListener('mouseleave', () => { if (!isPaused) timer = startTimer(); });
    }
  }
</script>
