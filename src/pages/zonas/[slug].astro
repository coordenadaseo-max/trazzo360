---
import Layout from '../../layouts/Layout.astro';
import Compromisos from '../../components/Compromisos.astro';
import { SITE, SERVICES, ZONES, ZONE_FAQS, SERVICE_ICONS, RELATED_ZONES } from '../../data/site';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths: GetStaticPaths = () =>
  ZONES.map(z => ({ params: { slug: z.slug }, props: { zone: z } }));

const { zone } = Astro.props;

const faqs = ZONE_FAQS[zone.slug] ?? [];
const relatedZoneSlugs: string[] = RELATED_ZONES[zone.slug] ?? [];
const relatedZones = ZONES.filter(z => relatedZoneSlugs.includes(z.slug));

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio',  item: `${SITE.url}/` },
    { '@type': 'ListItem', position: 2, name: zone.name, item: `${SITE.url}/zonas/${zone.slug}/` },
  ],
};

const zoneSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: `Obras y reformas en ${zone.name}`,
  url: `${SITE.url}/zonas/${zone.slug}/`,
  description: `Reformas integrales, baños, cocinas, pisos, locales y comunidades de vecinos en ${zone.name}. Precio cerrado y presupuesto gratis en 24h.`,
  provider: { '@type': 'GeneralContractor', '@id': `${SITE.url}/#business` },
  areaServed: { '@type': 'City', name: zone.name },
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(f => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<Layout
  title={(() => {
    if ((zone as any).seoTitle) return (zone as any).seoTitle;
    const raw = `Empresa de Reformas en ${zone.name} | ${SITE.name}`;
    if (raw.length < 50) {
      const mod: string = (zone as any).seoModifier ?? '· Precio Cerrado';
      const withMod = `Empresa de Reformas en ${zone.name} ${mod} | ${SITE.name}`;
      return withMod.length <= 60 ? withMod : raw;
    }
    return raw;
  })()}
  description={`Trazzo360, empresa de reformas en ${zone.name}. Reformas integrales, baños, cocinas, pisos y locales. Precio cerrado y presupuesto gratis en 24h.`}
  schema={[zoneSchema, breadcrumbSchema, faqSchema]}
>

  <!-- Breadcrumb -->
  <nav aria-label="Migas de pan" class="bg-gray-50 border-b border-gray-100">
    <div class="max-w-7xl mx-auto px-4 py-3">
      <ol class="text-sm text-gray-500 flex items-center gap-2" style="list-style:none;padding:0;margin:0">
        <li><a href="/" class="hover:text-[#A85535] transition-colors">Inicio</a></li>
        <li aria-hidden="true" class="text-gray-300">/</li>
        <li>Zonas</li>
        <li aria-hidden="true" class="text-gray-300">/</li>
        <li class="text-gray-800 font-medium" aria-current="page">{zone.name}</li>
      </ol>
    </div>
  </nav>

  <!-- Hero -->
  <section class="bg-[#111827] py-20 lg:py-28" aria-labelledby="h-hero">
    <div class="max-w-7xl mx-auto px-4">
      <div class="max-w-3xl">
        <div class="flex items-center gap-3 mb-6">
          <div class="w-8 h-0.5 bg-[#A85535]"></div>
          <span class="text-xs font-bold uppercase tracking-widest text-[#A85535]">{SITE.zone}</span>
        </div>
        <h1 id="h-hero" class="text-4xl lg:text-6xl font-black text-white mb-5" style="letter-spacing:-0.02em">
          Empresa de reformas<br/>
          <span class="text-[#A85535]">en {zone.name}</span>
        </h1>
        <p class="text-lg text-gray-300 leading-relaxed mb-8">
          {zone.heroIntro}
        </p>
        <div class="flex flex-col sm:flex-row gap-4">
          <a href="/contacto/" class="inline-block text-center px-8 py-4 font-bold text-sm tracking-widest uppercase text-white hover:opacity-90 transition-opacity" style="background:#A85535">
            Solicitar presupuesto en {zone.name}
          </a>
          <a href={`tel:${SITE.phone}`} class="inline-block text-center px-8 py-4 font-bold text-sm tracking-widest uppercase text-white border-2 border-white/30 hover:border-white transition-colors">
            ☎ {SITE.phoneDisplay}
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Todos los servicios -->
  <section class="py-20 bg-white" aria-labelledby="h-servicios">
    <div class="max-w-7xl mx-auto px-4">
      <h2 id="h-servicios" class="text-3xl font-black text-gray-900 mb-3" style="letter-spacing:-0.02em">
        Obras y reformas disponibles en {zone.name}
      </h2>
      <p class="text-gray-600 leading-relaxed mb-3 max-w-2xl">
        Cubrimos todos los tipos de obra en {zone.name} con el mismo precio cerrado y el mismo compromiso de plazo. Elige el servicio que necesitas para ver precios orientativos, el proceso de trabajo y ejemplos reales.
      </p>
      <div class="w-12 h-1 bg-[#A85535] mb-10"></div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {SERVICES.map(s => (
          <a href={`/${s.slug}/${zone.slug}/`}
            class="group block p-7 bg-gray-50 border-b-4 border-transparent hover:border-[#A85535] hover:shadow-lg transition-all duration-200">
            <div class="w-8 h-8 text-[#A85535] mb-4"><Fragment set:html={SERVICE_ICONS[s.slug] ?? ''} /></div>
            <h3 class="text-lg font-bold text-gray-900 mb-2">{s.title} en {zone.name}</h3>
            <p class="text-sm text-gray-500 leading-relaxed mb-3">{s.desc}</p>
            <p class="text-xs font-bold text-gray-400 mb-3">
              Desde <span class="text-[#A85535] text-sm font-black">{s.priceFrom}€</span>
              <span class="font-normal"> · {s.priceDesc}</span>
            </p>
            <span class="text-xs font-bold text-[#A85535] block group-hover:underline">
              Ver precios de {s.anchorLabel.toLowerCase()} en {zone.name} →
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- M2 — Barrio por barrio -->
  <section class="py-20 bg-[#F9F7F4]" aria-labelledby="h-barrios-contexto">
    <div class="max-w-4xl mx-auto px-4">
      <h2 id="h-barrios-contexto" class="text-2xl font-black text-gray-900 mb-3" style="letter-spacing:-0.02em">
        Cómo es el parque de vivienda en {zone.name}
      </h2>
      <p class="text-gray-600 leading-relaxed mb-10">
        {zone.name} {zone.localAngle}. El tipo de vivienda predominante, la época de construcción y el estado de las instalaciones determinan qué reformas son más frecuentes en cada barrio.
      </p>

      <div class="space-y-6 mb-10">
        {zone.m2BarrioNotes.map((note: { barrio: string; text: string }) => (
          <div class="bg-white border-l-4 border-[#A85535] p-6">
            <h3 class="font-bold text-gray-900 mb-2">{note.barrio}</h3>
            <p class="text-sm text-gray-600 leading-relaxed">{note.text}</p>
          </div>
        ))}
      </div>

      <!-- M3 — Permisos y logística -->
      <div class="bg-[#111827] p-6 text-white">
        <p class="text-xs font-bold uppercase tracking-widest text-[#A85535] mb-3">Permisos y tramitación</p>
        <p class="text-sm text-gray-300 leading-relaxed">{zone.m3Permits}</p>
      </div>
    </div>
  </section>

  <!-- Obras más habituales -->
  <section class="py-20 bg-white" aria-labelledby="h-obras-habituales">
    <div class="max-w-7xl mx-auto px-4">
      <h2 id="h-obras-habituales" class="text-2xl font-black text-gray-900 mb-3" style="letter-spacing:-0.02em">
        Obras más habituales en {zone.name}
      </h2>
      <p class="text-gray-500 text-sm mb-10">
        Estas son las actuaciones que más presupuestamos en {zone.name}. El alcance exacto depende siempre del estado real de la vivienda.
      </p>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {zone.topWorks.map((w: { title: string; desc: string }) => (
          <div class="p-6 bg-gray-50 border-t-4 border-[#A85535]">
            <h3 class="font-bold text-gray-900 mb-2">{w.title}</h3>
            <p class="text-sm text-gray-600 leading-relaxed">{w.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- M8 — Compromisos -->
  <section class="py-16 bg-[#F9F7F4]" aria-labelledby="h-compromisos">
    <div class="max-w-7xl mx-auto px-4 grid lg:grid-cols-2 gap-12 items-center">
      <div>
        <h2 id="h-compromisos" class="text-2xl font-black text-gray-900 mb-6">
          Lo que asumimos antes de empezar en {zone.name}
        </h2>
        <Compromisos variant="condensed" />
        <p class="text-xs text-gray-400 mt-5">
          <a href="/como-trabajamos/" class="text-[#A85535] hover:underline font-medium">Ver todos nuestros compromisos →</a>
        </p>
      </div>
      <div class="bg-[#111827] p-8 text-white">
        <p class="text-xs font-bold uppercase tracking-widest text-[#A85535] mb-4">Presupuesto gratuito</p>
        <p class="text-xl font-black text-white mb-2">Respondemos en 24h. Presupuesto cerrado tras la visita.</p>
        <p class="text-sm text-gray-400 mb-6">
          Sin compromiso. Cuéntanos qué quieres reformar en {zone.name}, concertamos visita técnica y entregamos presupuesto cerrado en 48h.
        </p>
        <a href="/contacto/" class="block text-center py-3.5 font-bold text-sm uppercase tracking-widest text-white hover:opacity-90 transition-opacity mb-3" style="background:#A85535">
          Solicitar presupuesto en {zone.name}
        </a>
        <a href={`tel:${SITE.phone}`} class="block text-center py-3 text-sm text-gray-300 border border-white/20 hover:border-white transition-colors">
          ☎ {SITE.phoneDisplay}
        </a>
      </div>
    </div>
  </section>

  <!-- Barrios -->
  <section class="py-14 bg-white">
    <div class="max-w-7xl mx-auto px-4">
      <h2 class="text-xl font-black text-gray-900 mb-2">
        Barrios y zonas de {zone.name} donde actuamos
      </h2>
      <p class="text-sm text-gray-500 mb-6">
        Cubrimos todos los barrios y urbanizaciones de {zone.name} sin coste adicional por desplazamiento. Si tu dirección no aparece en la lista, consúltanos igualmente.
      </p>
      <ul class="flex flex-wrap gap-2" style="list-style:none;padding:0;margin:0">
        {zone.neighborhoods.map((n: string) => (
          <li class="inline-block px-4 py-2 bg-gray-50 border border-gray-200 text-sm text-gray-700 font-medium">
            {n}
          </li>
        ))}
        <li class="inline-block px-4 py-2 bg-gray-50 border border-dashed border-gray-300 text-sm text-gray-400">
          ¿Tu barrio no aparece? Consúltanos
        </li>
      </ul>
    </div>
  </section>

  <!-- Otras zonas -->
  <section class="py-14 bg-[#F9F7F4]">
    <div class="max-w-7xl mx-auto px-4">
      <h2 class="text-xl font-black text-gray-900 mb-2">
        También hacemos obras en estos municipios del Corredor
      </h2>
      <p class="text-sm text-gray-500 mb-6">
        Cubrimos todo el Corredor del Henares sin coste de desplazamiento adicional.
      </p>
      <div class="flex flex-wrap gap-2">
        {relatedZones.map(z => (
          <a
            href={`/zonas/${z.slug}/`}
            class="inline-block px-4 py-2 text-sm text-gray-600 bg-white border border-gray-200 hover:bg-[#A85535] hover:text-white hover:border-[#A85535] transition-all font-medium"
          >
            Empresa de obras en {z.name}
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-20 bg-white" aria-labelledby="h-faq">
    <div class="max-w-4xl mx-auto px-4">
      <h2 id="h-faq" class="text-2xl font-black text-gray-900 mb-4">
        Preguntas frecuentes sobre obras en {zone.name}
      </h2>
      <p class="text-gray-600 leading-relaxed mb-8">
        Si tienes dudas sobre plazos, precios o qué incluye cada servicio en {zone.name}, aquí respondemos las más habituales. Si no encuentras la tuya, escríbenos o llámanos y te respondemos el mismo día.
      </p>
      <div class="divide-y divide-gray-200">
        {faqs.map(faq => (
          <details class="group py-5">
            <summary class="flex justify-between items-start gap-4 cursor-pointer list-none">
              <h3 class="font-semibold text-gray-900 text-base leading-snug m-0">{faq.q}</h3>
              <span class="text-[#A85535] text-2xl leading-none flex-shrink-0 group-open:rotate-45 transition-transform">+</span>
            </summary>
            <p class="mt-4 text-gray-500 leading-relaxed text-sm">{faq.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA Final -->
  <section class="py-16 bg-[#A85535]" aria-labelledby="h-cta-final">
    <div class="max-w-4xl mx-auto px-4 text-center">
      <h2 id="h-cta-final" class="text-3xl font-black text-white mb-3">
        ¿Necesitas presupuesto de obra en {zone.name}?
      </h2>
      <p class="text-white/80 mb-7">Visita gratuita. Presupuesto cerrado en 48h. Sin letra pequeña.</p>
      <a href="/contacto/" class="inline-block px-10 py-4 font-bold text-sm uppercase tracking-widest bg-white text-[#A85535] hover:bg-gray-100 transition-colors">
        Solicitar valoración gratuita
      </a>
    </div>
  </section>

</Layout>
