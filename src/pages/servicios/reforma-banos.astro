  @media(min-width:1024px){
    .obra-timeline-grid { grid-template-columns:repeat(4,1fr); }
    .obra-timeline-grid > .obra-timeline-cell:nth-child(1),
    .obra-timeline-grid > .obra-timeline-cell:nth-child(2) { border-bottom:none; }
    .obra-timeline-grid > .obra-timeline-cell:nth-child(2) { border-right:1px solid rgba(255,255,255,.12); }
  }

  /* ── Precio apertura grid ── */
  .precio-apertura-grid { display:grid; gap:1.5rem; }
  @media(min-width:768px){ .precio-apertura-grid { grid-template-columns:auto 1fr; gap:3rem; align-items:end; } }

  /* ── Compromisos apertura grid ── */
  .compromisos-apertura-grid { display:grid; gap:2rem; }
  @media(min-width:768px){ .compromisos-apertura-grid { grid-template-columns:auto 1fr; gap:4rem; align-items:start; } }

  /* ── Resultado cotidiano ── */
  .resultado-wrap { background:#111827; padding:clamp(4rem,8vw,7rem) 0; border-top:2px solid #A85535; }
  .resultado-tag { font-size:0.5625rem; font-weight:700; letter-spacing:0.1em; text-transform:uppercase; font-family:'Courier New', monospace; color:#A85535; margin-bottom:2rem; }
  .resultado-body { margin:0; padding:0; border:none; }
  .resultado-lead { font-size:clamp(1.375rem,3vw,2.25rem); color:rgba(255,255,255,.9); line-height:1.25; font-weight:700; letter-spacing:-0.02em; max-width:22ch; margin-bottom:1.75rem; }
  .resultado-detail { font-size:clamp(1rem,2vw,1.375rem); color:rgba(255,255,255,.72); line-height:1.55; max-width:36ch; margin-bottom:2rem; font-weight:400; }
  .resultado-kicker { font-size:clamp(1rem,1.75vw,1.25rem); color:rgba(255,255,255,.75); line-height:1.4; max-width:32ch; font-weight:600; letter-spacing:-0.01em; padding-top:2rem; border-top:1px solid rgba(255,255,255,.08); }

  /* ── CTA strip ── */
  .cta-strip { display:flex; flex-direction:column; align-items:center; gap:1.25rem; }
  @media(min-width:640px){ .cta-strip { flex-direction:row; justify-content:center; gap:0; } }
  .cta-strip__item { display:flex; flex-direction:column; gap:0.25rem; }
  @media(min-width:640px){ .cta-strip__item { padding:0 2.5rem; } }
  .cta-strip__val { font-size:1rem; font-weight:800; color:#fff; letter-spacing:-0.02em; font-variant-numeric:tabular-nums; }
  .cta-strip__label { font-size:0.625rem; font-weight:700; letter-spacing:0.1em; text-transform:uppercase; font-family:'Courier New', monospace; color:rgba(255,255,255,.65); }
  .cta-strip__sep { display:none; }
  @media(min-width:640px){ .cta-strip__sep { display:block; width:1px; height:2.5rem; background:rgba(255,255,255,.1); align-self:center; } }

  /* ── Browser surfaces ── */
  ::selection { background:#A85535; color:#fff; }
  :focus-visible { outline:2px solid #A85535; outline-offset:3px; }
  ::-webkit-scrollbar { width:6px; }
  ::-webkit-scrollbar-track { background:transparent; }
  ::-webkit-scrollbar-thumb { background:#D1C9BD; }
  ::-webkit-scrollbar-thumb:hover { background:#A85535; }

  /* ── Reduced motion ── */
  @media(prefers-reduced-motion:reduce) {
    .reveal, .reveal-stagger > * { opacity:1; transform:none; transition:none; }
    .hero-scroll { display:none; }
    .hero-line > span { animation:none; transform:none; }
    .hero-sub { animation:none; opacity:1; }
    .zona-card, .zona-card__title, .zona-card__sub,
    .zona-pill, .price-guide-chip, .price-guide-chip__arrow,
    .faq-summary, .faq-chevron { transition:none; }
  }
</style>

<script>
  // Hero parallax
  const heroImgEl = document.querySelector('.hero-img') as HTMLElement;
  if (heroImgEl && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    heroImgEl.style.willChange = 'transform';
    window.addEventListener('scroll', () => {
      heroImgEl.style.transform = `translateY(${window.scrollY * 0.28}px)`;
    }, { passive: true });
  }

  // Scroll reveals
  const io = new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) { e.target.classList.add('visible'); io.unobserve(e.target); }
    });
  }, { threshold: 0.1 });
  document.querySelectorAll('.reveal, .reveal-stagger').forEach(el => io.observe(el));
</script>

</Layout>
