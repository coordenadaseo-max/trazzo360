---
import Layout from '../layouts/Layout.astro';
import { SITE, SERVICES } from '../data/site';
---

<Layout
  title={`Solicitud recibida | ${SITE.name}`}
  description="Hemos recibido tu solicitud de presupuesto. Te contactamos en menos de 24 horas para concertar la visita técnica gratuita."
  robots="noindex, follow"
>

  <!-- Confirmación hero -->
  <section class="bg-[#111827] py-20 lg:py-28" aria-labelledby="h-confirmacion">
    <div class="max-w-2xl mx-auto px-4 text-center">
      <div class="w-16 h-16 rounded-full bg-[#A85535] flex items-center justify-center mx-auto mb-8">
        <svg class="w-8 h-8 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
        </svg>
      </div>
      <h1 id="h-confirmacion" class="text-4xl lg:text-5xl font-black text-white mb-4" style="letter-spacing:-0.02em">
        Solicitud recibida
      </h1>
      <p class="text-lg text-gray-300 mb-3">
        Te contactamos en menos de 24 horas (días laborables) para conocer tu proyecto y concertar la visita técnica gratuita.
      </p>
      <p class="text-sm text-gray-500 mb-8">Si tienes urgencia, llámanos directamente.</p>
      {SITE.phone !== 'TU_TELEFONO' && (
        <a href={`tel:${SITE.phone}`} class="inline-block px-8 py-3.5 text-sm font-bold uppercase tracking-widest text-white border border-white/30 hover:border-white transition-colors">
          ☎ {SITE.phoneDisplay}
        </a>
      )}
    </div>
  </section>

  <!-- Qué pasa ahora -->
  <section class="py-20 bg-white" aria-labelledby="h-que-pasa">
    <div class="max-w-3xl mx-auto px-4">
      <h2 id="h-que-pasa" class="text-2xl font-black text-gray-900 mb-3">Qué pasa a continuación</h2>
      <p class="text-gray-500 mb-8 max-w-xl">El proceso es siempre el mismo, independientemente del tipo de obra o del municipio.</p>
      <div class="w-12 h-1 bg-[#A85535] mb-10"></div>
      <ol style="list-style:none;padding:0;margin:0">
        {[
          {
            n: '1',
            title: 'Te llamamos en menos de 24h',
            desc: 'Revisamos tu solicitud y nos ponemos en contacto para escuchar los detalles del proyecto. Sin compromiso, sin presión de venta.',
          },
          {
            n: '2',
            title: 'Visita técnica gratuita en tu domicilio',
            desc: 'Acordamos una visita en tu vivienda o local para ver el estado real, tomar medidas y resolver cualquier duda sobre distribución o materiales. La visita no tiene coste y no te obliga a nada.',
          },
          {
            n: '3',
            title: 'Presupuesto cerrado en 48h',
            desc: 'Tras la visita recibes un presupuesto detallado con el precio final y el plazo de entrega. Sin partidas abiertas, sin letra pequeña. Lo que aparece en el documento es lo que pagas.',
          },
          {
            n: '4',
            title: 'Firma del contrato y fecha de inicio',
            desc: 'Si aceptas el presupuesto, firmamos el contrato y fijamos la fecha de comienzo. A partir de ese momento tienes precio, plazo y garantía de 2 años por escrito.',
          },
        ].map((step, i) => (
          <li class="flex gap-6 pb-8 last:pb-0">
            <div class="flex flex-col items-center">
              <div class="w-10 h-10 rounded-full bg-[#A85535] text-white font-black text-sm flex items-center justify-center flex-shrink-0">
                {step.n}
              </div>
              {i < 3 && <div class="w-px flex-1 bg-gray-100 mt-2"></div>}
            </div>
            <div class="pt-1 pb-2">
              <h3 class="font-bold text-gray-900 mb-1">{step.title}</h3>
              <p class="text-sm text-gray-500 leading-relaxed">{step.desc}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Qué preparar -->
  <section class="py-16 bg-[#F9F7F4]" aria-labelledby="h-preparar">
    <div class="max-w-3xl mx-auto px-4">
      <h2 id="h-preparar" class="text-xl font-black text-gray-900 mb-2">Qué puedes preparar antes de la visita</h2>
      <p class="text-sm text-gray-500 mb-8">No es obligatorio tener nada listo. Pero si quieres aprovechar mejor la visita:</p>
      <ul class="grid sm:grid-cols-2 gap-4" style="list-style:none;padding:0;margin:0">
        {[
          {
            title: 'Una lista de lo que quieres reformar',
            desc: 'Aunque sea informal. Saber si priorizas el baño, la cocina o una reforma integral nos ayuda a preparar las opciones más ajustadas.',
          },
          {
            title: 'Medidas aproximadas o plano',
            desc: 'Si conoces la superficie en m² o tienes algún plano, ahorra tiempo. Si no, las tomamos en la visita sin ningún problema.',
          },
          {
            title: 'Referencias visuales (opcional)',
            desc: 'Fotos de proyectos que te gusten — Pinterest, revistas o cualquier referencia. Ayudan a alinear el criterio estético antes de empezar.',
          },
          {
            title: 'Preguntas concretas',
            desc: 'Sobre plazos, materiales, financiación o permisos. Respondemos todo en la visita o en las 24h siguientes si requiere consulta técnica.',
          },
        ].map(item => (
          <li class="bg-white p-6 border border-gray-100">
            <div class="w-5 h-5 rounded-full bg-[#A85535] flex items-center justify-center mb-3" aria-hidden="true">
              <svg class="w-2.5 h-2.5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
              </svg>
            </div>
            <p class="text-sm font-bold text-gray-900 mb-1">{item.title}</p>
            <p class="text-xs text-gray-500 leading-relaxed">{item.desc}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Mientras esperas -->
  <section class="py-16 bg-white" aria-labelledby="h-mientras">
    <div class="max-w-3xl mx-auto px-4">
      <h2 id="h-mientras" class="text-xl font-black text-gray-900 mb-2">Mientras esperas nuestra llamada</h2>
      <p class="text-sm text-gray-500 mb-8">Puedes consultar precios orientativos o revisar cómo trabajamos antes de la visita.</p>
      <div class="grid sm:grid-cols-2 gap-4 mb-8">
        <a href="/como-trabajamos/" class="block p-5 bg-gray-50 border border-gray-100 hover:border-[#A85535] transition-colors group">
          <p class="text-sm font-bold text-gray-900 group-hover:text-[#A85535] transition-colors mb-1">Los 6 compromisos de Trazzo360</p>
          <p class="text-xs text-gray-400">Precio cerrado, garantía de 2 años, pago en fases. Todo lo que asumimos antes de firmar.</p>
        </a>
        {SERVICES.slice(0, 3).map(s => (
          <a href={`/servicios/${s.slug}/`} class="block p-5 bg-gray-50 border border-gray-100 hover:border-[#A85535] transition-colors group">
            <p class="text-sm font-bold text-gray-900 group-hover:text-[#A85535] transition-colors mb-1">{s.title}</p>
            <p class="text-xs text-gray-400">Desde {s.priceFrom}€ · {s.priceDesc}</p>
          </a>
        ))}
      </div>
      <a href="/" class="inline-block px-8 py-3.5 text-sm font-bold uppercase tracking-widest text-white hover:opacity-90 transition-opacity" style="background:#A85535">
        Volver al inicio
      </a>
    </div>
  </section>

</Layout>
