---
import '../../styles/global.css';
---
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex, nofollow, noarchive" />
  <title>LAB · Cocinas · Decisiones visuales y datos</title>
  <style>
    html { scroll-behavior: smooth }
    * { box-sizing: border-box }

    /* ── HÉROE LAYOUT ─────────────────────── */
    .hero-support-3col {
      display: grid;
      gap: 1.5rem;
    }
    @media (min-width: 1024px) {
      .hero-support-3col { grid-template-columns: 55fr 22fr 23fr; gap: 3rem; }
    }

    /* K2: plazo columns */
    .plazo-cols {
      display: grid;
      grid-template-columns: 1fr 1fr 1fr;
      gap: 1px;
      background: rgba(255,255,255,.08);
    }

    /* K3: tipología row */
    .tipologia-row {
      display: grid;
      gap: 1px;
      background: rgba(255,255,255,.08);
    }
    @media (min-width: 640px) {
      .tipologia-row { grid-template-columns: repeat(3, 1fr); }
    }

    /* ── PRECIO BANDS ─────────────────────── */
    .precio-tranche {
      border-top: 1px solid #D1C9BD;
      padding: 1.5rem 0;
    }
    .precio-tranche:last-child { border-bottom: 1px solid #D1C9BD; }

    .calidad-row {
      display: grid;
      grid-template-columns: 1fr 1fr 1fr;
      gap: 0;
    }
    .calidad-cell {
      padding: .75rem 1rem .75rem 0;
    }
    .calidad-cell + .calidad-cell {
      padding-left: 1rem;
      border-left: 1px solid #E5E0D8;
    }

    /* ── CONVIVENCIA ──────────────────────── */
    .timeline-weeks {
      display: grid;
      gap: 0;
    }
    @media (min-width: 640px) {
      .timeline-weeks { grid-template-columns: repeat(5, 1fr); }
    }

    .estado-phases {
      display: grid;
      gap: 1px;
      background: #D1C9BD;
    }
    @media (min-width: 640px) {
      .estado-phases { grid-template-columns: 1fr 1fr 1fr; }
    }

    /* ── MATRIZ ───────────────────────────── */
    .matriz-table {
      width: 100%;
      border-collapse: collapse;
      font-size: .8125rem;
    }
    .matriz-table th {
      text-align: left;
      padding: .5rem .75rem;
      background: #111827;
      color: #9CA3AF;
      font-size: .6875rem;
      letter-spacing: .1em;
      text-transform: uppercase;
    }
    .matriz-table td {
      padding: .5rem .75rem;
      border-bottom: 1px solid #E5E0D8;
      vertical-align: top;
      line-height: 1.4;
    }
    .matriz-table tr:hover td { background: #F3F0EB; }
    .ok  { color: #16a34a; font-weight: bold }
    .warn { color: #dc2626; font-weight: bold }
    .note { color: #9CA3AF; }

    /* ── FLUJO ────────────────────────────── */
    .flujo-grid {
      display: grid;
      gap: 1px;
      background: #D1C9BD;
    }
    @media (min-width: 768px) {
      .flujo-grid { grid-template-columns: repeat(2, 1fr); }
    }

    /* ── LAB DIVIDER ──────────────────────── */
    .lab-div {
      background: #fde047;
      color: #713f12;
      text-align: center;
      padding: .5rem 1rem;
      font-size: .625rem;
      font-weight: 900;
      letter-spacing: .2em;
      text-transform: uppercase;
    }
  </style>
</head>
<body class="font-sans antialiased m-0 p-0 bg-white">

  <!-- ══ LAB NAV ══════════════════════════════════════════ -->
  <div class="fixed top-0 left-0 right-0 z-50 bg-yellow-400 text-yellow-950 px-4 py-1.5 flex items-center justify-between">
    <span class="text-[10px] font-black uppercase tracking-[0.15em]">LAB · Cocinas · Decisiones pre-implementación</span>
    <nav class="hidden md:flex gap-3 text-[9px] font-bold uppercase tracking-widest">
      <a href="#matriz">1. Matriz</a>
      <a href="#heroes">2. Héroes K1/K2/K3</a>
      <a href="#mv1">4. Distribuciones</a>
      <a href="#mv2">5. Convivencia</a>
      <a href="#precios">6. Precios</a>
      <a href="#flujo">7. Flujo</a>
    </nav>
  </div>
  <div style="height:36px"></div>


  <!-- ══════════════════════════════════════════════════════
       ENTREGA 1 · MATRIZ DE PROCEDENCIA DE DATOS
  ═══════════════════════════════════════════════════════════ -->
  <section id="matriz" class="bg-[#F9F7F4] py-16">
    <div class="max-w-7xl mx-auto px-4">
      <p class="font-black uppercase text-[#A85535] mb-2" style="font-size:10px;letter-spacing:.15em">Entrega 1</p>
      <h2 class="font-black text-[#111827] mb-2" style="font-size:1.75rem;letter-spacing:-.025em">Matriz de procedencia de datos</h2>
      <p class="text-gray-500 mb-8" style="font-size:.875rem;max-width:65ch">
        Cada dato propuesto para la página. Las celdas vacías indican que esa columna no aplica.
        <strong class="text-[#dc2626]">Rojo = bloqueado hasta verificación del propietario.</strong>
      </p>

      <div style="overflow-x:auto">
        <table class="matriz-table">
          <thead>
            <tr>
              <th style="min-width:220px">Dato</th>
              <th>calculator.ts</th>
              <th>CLAUDE.md</th>
              <th>Página actual</th>
              <th>Estado</th>
              <th>Acción requerida</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><strong>Precio mínimo "desde 5.000 €"</strong> (hasta-8, esencial)</td>
              <td class="ok">✓ min:5000</td>
              <td></td>
              <td class="warn">5.500 € en JSON-LD</td>
              <td class="warn">⚠️ DISCREPANCIA</td>
              <td>Usar 5.000 € o confirmar si 5.500 € tiene origen</td>
            </tr>
            <tr>
              <td><strong>Plazo "2–4 semanas"</strong> (actual FAQ)</td>
              <td class="warn">Esencial: 3–5 sem</td>
              <td></td>
              <td class="warn">2–4 sem (L36)</td>
              <td class="warn">⚠️ DISCREPANCIA</td>
              <td>Corregir a 3–5 / 4–7 / 6–10 según calidad</td>
            </tr>
            <tr>
              <td><strong>Plazo esencial 3–5 semanas</strong></td>
              <td class="ok">✓ [3,5]</td>
              <td></td>
              <td></td>
              <td class="ok">✓ Autorizado</td>
              <td>Usar sin reformular como "media"</td>
            </tr>
            <tr>
              <td><strong>Plazo media 4–7 semanas</strong></td>
              <td class="ok">✓ [4,7]</td>
              <td></td>
              <td></td>
              <td class="ok">✓ Autorizado</td>
              <td></td>
            </tr>
            <tr>
              <td><strong>Plazo alta 6–10 semanas</strong></td>
              <td class="ok">✓ [6,10]</td>
              <td></td>
              <td></td>
              <td class="ok">✓ Autorizado</td>
              <td></td>
            </tr>
            <tr>
              <td><strong>Pago 40 / 40 / 20 %</strong></td>
              <td></td>
              <td class="ok">✓ Explícito</td>
              <td></td>
              <td class="ok">✓ Autorizado</td>
              <td></td>
            </tr>
            <tr>
              <td><strong>Garantía 2 años sobre ejecución</strong></td>
              <td></td>
              <td class="ok">✓ Explícito</td>
              <td></td>
              <td class="ok">✓ Autorizado</td>
              <td></td>
            </tr>
            <tr>
              <td><strong>Experiencia directa en obra</strong> (del responsable)</td>
              <td></td>
              <td class="ok">✓ Explícito</td>
              <td></td>
              <td class="ok">✓ Autorizado</td>
              <td>Solo atribuible a la persona, no a Trazzo360</td>
            </tr>
            <tr>
              <td><strong>Modificador antigüedad pre-1980 +14 %</strong></td>
              <td class="ok">✓ factor:1.14</td>
              <td></td>
              <td></td>
              <td class="ok">✓ Autorizado</td>
              <td>Solo en calculadora y contexto técnico</td>
            </tr>
            <tr>
              <td><strong>Modificador redistribución completa +25 %</strong></td>
              <td class="ok">✓ factor:1.25</td>
              <td></td>
              <td></td>
              <td class="ok">✓ Autorizado</td>
              <td></td>
            </tr>
            <tr>
              <td><strong>Modificador sin ascensor +9 %</strong></td>
              <td class="ok">✓ factor:1.09</td>
              <td></td>
              <td></td>
              <td class="ok">✓ Autorizado</td>
              <td></td>
            </tr>
            <tr>
              <td><strong>Desglose por partidas</strong> (demolición 8 %, instalaciones 15 %…)</td>
              <td class="ok">✓ breakdown</td>
              <td></td>
              <td></td>
              <td class="ok">✓ Autorizado</td>
              <td>Presentar como orientativo del peso relativo</td>
            </tr>
            <tr>
              <td><strong>IVA 10 % vivienda habitual no incluido</strong></td>
              <td class="ok">✓ neverIncludes</td>
              <td></td>
              <td></td>
              <td class="ok">✓ Autorizado</td>
              <td></td>
            </tr>
            <tr>
              <td><strong>Electrodomésticos de superficie libre no incluidos</strong></td>
              <td class="ok">✓ neverIncludes</td>
              <td></td>
              <td></td>
              <td class="ok">✓ Autorizado</td>
              <td></td>
            </tr>
            <tr style="background:#fef2f2">
              <td><strong>Encimera: precios €/ml</strong> (laminado 80-150, silestone 250-450…)</td>
              <td class="warn">No existe</td>
              <td class="warn">No existe</td>
              <td>Sí (L408-460)</td>
              <td class="warn">⛔ SIN FUENTE</td>
              <td>Eliminar o que el propietario confirme la fuente</td>
            </tr>
            <tr style="background:#fef2f2">
              <td><strong>Potencia inducción 7.2–11 kW</strong></td>
              <td class="warn">No existe</td>
              <td class="warn">No existe</td>
              <td>Sí (inferido)</td>
              <td class="warn">⛔ SIN FUENTE</td>
              <td>Eliminar o confirmar fuente técnica</td>
            </tr>
            <tr style="background:#fef2f2">
              <td><strong>Isla: mínimo 15 m²</strong></td>
              <td class="warn">No existe</td>
              <td class="warn">No existe</td>
              <td>Inferencia</td>
              <td class="warn">⛔ SIN FUENTE</td>
              <td>Eliminar o confirmar fuente técnica (es estándar de diseño)</td>
            </tr>
            <tr style="background:#fef2f2">
              <td><strong>Isla: pasillo mínimo 1.20 m</strong></td>
              <td class="warn">No existe</td>
              <td class="warn">No existe</td>
              <td>Inferencia</td>
              <td class="warn">⛔ SIN FUENTE</td>
              <td>Eliminar o confirmar (norma ergonómica habitual)</td>
            </tr>
            <tr style="background:#fef2f2">
              <td><strong>Conductos compartidos en bloque</strong></td>
              <td class="warn">No existe</td>
              <td class="warn">No existe</td>
              <td>Editorial</td>
              <td class="warn">⚠️ EDITORIAL</td>
              <td>Verificar si el responsable lo confirma como hecho habitual</td>
            </tr>
            <tr>
              <td><strong>Equipos estables, un solo interlocutor</strong></td>
              <td></td>
              <td class="ok">✓ Explícito</td>
              <td></td>
              <td class="ok">✓ Autorizado</td>
              <td>Nunca "equipo propio" ni "sin subcontratas"</td>
            </tr>
            <tr>
              <td><strong>Municipio principal: Torrejón de Ardoz</strong></td>
              <td></td>
              <td class="ok">✓ Explícito</td>
              <td></td>
              <td class="ok">✓ Autorizado</td>
              <td></td>
            </tr>
          </tbody>
        </table>
      </div>

      <div class="mt-6 p-4 bg-red-50" style="border-left:3px solid #dc2626">
        <p class="font-bold text-red-700 text-sm mb-1">Pendiente de autorización del propietario</p>
        <p class="text-red-600" style="font-size:.8125rem">
          (a) Confirmar si "5.500 €" tiene origen distinto al calculator.ts o corregir a "desde 5.000 €" ·
          (b) Confirmar si los €/ml de encimeras son datos propios o eliminar ·
          (c) Confirmar si 15 m² / 1,20 m de isla son datos que el responsable puede avalar
        </p>
      </div>
    </div>
  </section>


  <!-- ══════════════════════════════════════════════════════
       ENTREGA 2–3 · HÉROES K1 / K2 / K3
  ═══════════════════════════════════════════════════════════ -->
  <div class="lab-div" id="heroes">↓ ENTREGA 2–3 · HÉROES K1 / K2 / K3 ↓</div>

  <!-- ── HERO K1 ───────────────────────────────────────────
       Tesis: la complejidad gestionada
       Distinción: sin trazo lateral, sin eyebrow.
       El H1 termina en punto —declaración cerrada.
       La fecha de entrega y el plazo están en el contrato,
       no como promesa sino como hecho verificable.
  ─────────────────────────────────────────────────────────── -->
  <section id="k1" class="bg-[#111827] flex flex-col justify-end relative"
           style="min-height:100vh;padding-top:2.5rem;padding-bottom:4rem">

    <div class="absolute top-12 left-0 right-0 flex justify-center pointer-events-none">
      <span class="text-[10px] font-black uppercase tracking-[0.2em] text-white/20">
        K1 · Tesis: la complejidad gestionada · Sin trazo terracota en H1
      </span>
    </div>

    <div class="max-w-7xl mx-auto px-4 lg:px-8 w-full">
      <h1 class="font-black text-white"
          style="font-size:clamp(2.75rem,8.5vw,8rem);letter-spacing:-0.04em;line-height:0.88;text-wrap:balance">
        Reforma de Cocinas<br>en el Corredor<br>del Henares.
      </h1>
    </div>

    <div class="max-w-7xl mx-auto px-4 lg:px-8 w-full" style="margin-top:clamp(2rem,4vw,3rem)">
      <div style="border-top:1px solid rgba(255,255,255,.15);padding-top:clamp(1.5rem,2.5vw,2.5rem)">
        <div class="hero-support-3col">

          <div>
            <p style="color:#9CA3AF;font-size:clamp(0.875rem,1.4vw,1.0625rem);max-width:52ch;line-height:1.65">
              Una reforma de cocina tiene más variables que cualquier otra obra dentro de la vivienda: instalaciones, distribución, materiales y plazos de entrega que hay que coordinar antes de la primera jornada. En Trazzo360 cerramos el diseño, la instalación y la fecha de entrega antes de empezar.
            </p>
            <p style="color:#9CA3AF;font-size:.875rem;line-height:1.65;margin-top:1rem;max-width:52ch">
              Lo que queda sin decidir al inicio es lo que convierte una reforma en una obra que se alarga.
            </p>
          </div>

          <div class="flex flex-col gap-3">
            <a href="/contacto/" class="inline-block text-center text-white font-black text-xs uppercase"
               style="padding:.9rem 1.5rem;background:#A85535;letter-spacing:.1em">
              Pedir valoración gratuita
            </a>
            <a href="tel:000" class="inline-block text-center font-black text-xs uppercase"
               style="padding:.9rem 1.5rem;border:1px solid rgba(255,255,255,.25);color:#fff;letter-spacing:.1em">
              Llamar ahora
            </a>
            <p class="text-[10px] text-white/30 uppercase tracking-wider">Visita técnica gratuita · Sin compromiso</p>
          </div>

          <div class="hidden lg:flex flex-col justify-end gap-5 text-right">
            <div>
              <p class="text-white font-black leading-none" style="font-size:clamp(1.5rem,2.5vw,2rem);letter-spacing:-0.03em">2 años</p>
              <p style="font-size:9px;color:#9CA3AF;margin-top:4px;letter-spacing:.1em;text-transform:uppercase">Garantía sobre la ejecución</p>
            </div>
            <div>
              <p class="text-white font-black leading-none" style="font-size:clamp(1.5rem,2.5vw,2rem);letter-spacing:-0.03em">Precio cerrado</p>
              <p style="font-size:9px;color:#9CA3AF;margin-top:4px;letter-spacing:.1em;text-transform:uppercase">Por contrato antes de empezar</p>
            </div>
            <div>
              <p class="text-white font-black leading-none" style="font-size:clamp(1.5rem,2.5vw,2rem);letter-spacing:-0.03em">40/40/20</p>
              <p style="font-size:9px;color:#9CA3AF;margin-top:4px;letter-spacing:.1em;text-transform:uppercase">Forma de pago por fases</p>
            </div>
          </div>

        </div>

        <div class="flex gap-5 mt-8 lg:hidden">
          <div>
            <p class="text-white font-black" style="font-size:1.125rem;letter-spacing:-0.02em">2 años</p>
            <p style="font-size:9px;color:#9CA3AF;margin-top:2px;letter-spacing:.1em;text-transform:uppercase">Garantía</p>
          </div>
          <div>
            <p class="text-white font-black" style="font-size:1.125rem;letter-spacing:-0.02em">Precio cerrado</p>
            <p style="font-size:9px;color:#9CA3AF;margin-top:2px;letter-spacing:.1em;text-transform:uppercase">Por contrato</p>
          </div>
          <div>
            <p class="text-white font-black" style="font-size:1.125rem;letter-spacing:-0.02em">40/40/20</p>
            <p style="font-size:9px;color:#9CA3AF;margin-top:2px;letter-spacing:.1em;text-transform:uppercase">Pago por fases</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <div class="lab-div">↓ HERO K2 ↓</div>

  <!-- ── HERO K2 ───────────────────────────────────────────
       Tesis: el plazo como eje editorial
       El plazo aparece desglosado por calidad (datos autorizados).
       Solo horquillas reales. Sin "media" ni "aproximadamente".
       Sin trazo terracota decorativo.
  ─────────────────────────────────────────────────────────── -->
  <section id="k2" class="bg-[#111827] flex flex-col justify-end relative"
           style="min-height:100vh;padding-top:2.5rem;padding-bottom:4rem">

    <div class="absolute top-12 left-0 right-0 flex justify-center pointer-events-none">
      <span class="text-[10px] font-black uppercase tracking-[0.2em] text-white/20">
        K2 · Tesis: plazo como editorial · Datos autorizados calculator.ts
      </span>
    </div>

    <div class="max-w-7xl mx-auto px-4 lg:px-8 w-full">
      <p class="font-black uppercase text-white/30 mb-4" style="font-size:10px;letter-spacing:.15em">
        Reforma de cocinas · Corredor del Henares
      </p>
      <h1 class="font-black text-white"
          style="font-size:clamp(2.5rem,7.5vw,7rem);letter-spacing:-0.04em;line-height:0.88;text-wrap:balance;max-width:16ch">
        El plazo en el contrato antes de empezar.
      </h1>
    </div>

    <div class="max-w-7xl mx-auto px-4 lg:px-8 w-full" style="margin-top:clamp(2rem,4vw,3rem)">
      <div style="border-top:1px solid rgba(255,255,255,.15);padding-top:clamp(1.5rem,2.5vw,2.5rem)">

        <!-- Plazo cols — datos exactos de calculator.ts -->
        <div class="plazo-cols mb-8" style="max-width:48rem">
          {[
            { calidad: 'Esencial', plazo: '3 – 5 sem.', sub: 'Renovación de acabados y mobiliario', fuente: 'calculator.ts · timelineWeeks:[3,5]' },
            { calidad: 'Media',    plazo: '4 – 7 sem.', sub: 'Instalaciones revisadas o redistribución parcial', fuente: 'calculator.ts · timelineWeeks:[4,7]' },
            { calidad: 'Alta',     plazo: '6 – 10 sem.', sub: 'Redistribución completa o materiales de encargo', fuente: 'calculator.ts · timelineWeeks:[6,10]' },
          ].map(({ calidad, plazo, sub, fuente }) => (
            <div style="padding:1.25rem;background:rgba(255,255,255,.04)">
              <p style="font-size:9px;color:#9CA3AF;letter-spacing:.12em;text-transform:uppercase;margin-bottom:.5rem">{calidad}</p>
              <p class="font-black text-white" style="font-size:clamp(1.25rem,2.5vw,1.75rem);letter-spacing:-0.03em;line-height:1">{plazo}</p>
              <p style="font-size:.75rem;color:#9CA3AF;margin-top:.5rem;line-height:1.4">{sub}</p>
              <p style="font-size:.625rem;color:rgba(255,255,255,.15);margin-top:.75rem;font-style:italic">{fuente}</p>
            </div>
          ))}
        </div>

        <div class="hero-support-3col">
          <p style="color:#9CA3AF;font-size:clamp(0.875rem,1.4vw,1.0625rem);max-width:52ch;line-height:1.65">
            El plazo que aparece en el presupuesto es el plazo que firmamos. No una estimación orientativa: una fecha de entrega con la que organizas tu vida. Cuando los materiales están pedidos antes de que empiece la obra, no hay pausas por espera de suministros.
          </p>
          <div class="flex flex-col gap-3">
            <a href="/contacto/" class="inline-block text-center text-white font-black text-xs uppercase"
               style="padding:.9rem 1.5rem;background:#A85535;letter-spacing:.1em">
              Pedir valoración gratuita
            </a>
            <a href="tel:000" class="inline-block text-center font-black text-xs uppercase"
               style="padding:.9rem 1.5rem;border:1px solid rgba(255,255,255,.25);color:#fff;letter-spacing:.1em">
              Llamar ahora
            </a>
          </div>
          <div class="hidden lg:flex flex-col justify-end gap-5 text-right">
            <div>
              <p class="text-white font-black leading-none" style="font-size:clamp(1.5rem,2.5vw,2rem);letter-spacing:-0.03em">2 años</p>
              <p style="font-size:9px;color:#9CA3AF;margin-top:4px;letter-spacing:.1em;text-transform:uppercase">Garantía sobre la ejecución</p>
            </div>
            <div>
              <p class="text-white font-black leading-none" style="font-size:clamp(1.5rem,2.5vw,2rem);letter-spacing:-0.03em">Precio cerrado</p>
              <p style="font-size:9px;color:#9CA3AF;margin-top:4px;letter-spacing:.1em;text-transform:uppercase">Por contrato</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <div class="lab-div">↓ HERO K3 ↓</div>

  <!-- ── HERO K3 ───────────────────────────────────────────
